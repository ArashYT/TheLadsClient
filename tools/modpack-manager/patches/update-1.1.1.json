{
  "packId": "zero-smp-1.20.1",
  "version": "1.1.1",
  "description": "Zero SMP performance tuning: Grassier Grass radius 80, rain particle de-duplication (Particular rain ripples and Immersive Winds splashes, which ParticleRain already draws), prune 3 orphan client jars (Corgilib and Data Anchor stay: the Zero SMP server requires their network channels). Reviewed: ModernFix opt-ins, ParticleRain's particle cap and Particular's drip ripples stay at their defaults.",
  "mods": {
    "add": [],
    "remove": [
      "cullleaves-forge-4.1.1+1.20.1.jar",
      "midnightlib-forge-1.9.2+1.20.1.jar",
      "player-animation-lib-forge-1.0.2-rc1+1.20.jar"
    ]
  },
  "keybinds": {
    "defaults": {},
    "force": {}
  },
  "configPatches": [
    {
      "file": "config/grassiergrass-client.toml",
      "format": "toml",
      "keyValues": {
        "renderRadius": "80"
      }
    },
    {
      "file": "config/particular-common.toml",
      "format": "toml",
      "keyValues": {
        "rainRipples": "false",
        "waterDripRipples": "true"
      }
    },
    {
      "file": "config/immersivewind.json",
      "format": "json",
      "set": {
        "enableRainHitParticles": false,
        "enableSplashParticles": false
      }
    },
    {
      "file": "config/particlerain/config.json",
      "format": "json",
      "set": {
        "perf.maxParticleAmount": 1500
      }
    },
    {
      "file": "config/modernfix-mixins.properties",
      "format": "properties",
      "keyValues": {
        "mixin.perf.dynamic_resources": "false",
        "mixin.perf.clear_mixin_classinfo": "false",
        "mixin.perf.faster_item_rendering": "false"
      }
    }
  ]
}
