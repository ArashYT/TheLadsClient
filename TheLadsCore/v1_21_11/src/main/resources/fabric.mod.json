{
  "schemaVersion": 1,
  "id": "theladscore",
  "version": "${version}",
  "name": "The Lads Core",
  "description": "The Lads Core multi-version client mod (1.21.11)",
  "authors": ["The Lads"],
  "license": ["CC0-1.0", "MPL-2.0", "LGPL-3.0-only", "Apache-2.0", "MIT"],
  "icon": "assets/modid/icon.png",
  "environment": "client",
  "accessWidener": "theladscore.accesswidener",
  "entrypoints": {
    "main": [
      "com.thelads.core.v1_21_11.embedded.EmbeddedModsMain"
    ],
    "client": [
      "com.thelads.core.v1_21_11.TheLadsCoreClient12111"
    ]
  },
  "mixins": [
    "theladscore.v1_21_11.mixins.json",
    "theladscore.v1_21_11.hud.mixins.json",
    "theladscore.v1_21_11.qa.mixins.json",
    "theladscore.v1_21_11.chrome.mixins.json",
    "theladscore.embedded.ksyxis.mixins.json",
    "theladscore.embedded.serverpingerfixer.mixins.json",
    "theladscore.embedded.fastipping.mixins.json",
    "theladscore.embedded.quickpack.mixins.json",
    "theladscore.embedded.lazyai.mixins.json"
  ],
  "custom": {
    "badoptimizations:cache_hooks": { "lightmap": "com.thelads.core.v1_21_11.feature.FullbrightLightmapHook" }
  },
  "depends": {
    "fabricloader": ">=0.19.3",
    "fabric-api": "*",
    "minecraft": "1.21.11",
    "java": ">=21"
  }
}
