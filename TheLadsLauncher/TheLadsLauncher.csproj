<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>1.11.2</Version>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <DefaultItemExcludes>$(DefaultItemExcludes);.agents\**</DefaultItemExcludes>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <!-- Precompiled code for the published launcher: less JIT work on every cold start. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- Horizon mods (HorizonEngine.InstallLadsMods) are copied next to the launcher, not embedded. -->
    <AvaloniaResource Remove="Assets\horizon\**" />
    <Content Include="Assets\horizon\*.hmod" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\docs\releases\*.md" Link="release-notes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game-mods\**\*.jar" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="game-mods\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Pack patches for the official modpacks (ExperiencesService.BundledPatchesDirectory): installed packs get them with the launcher update. -->
    <Content Include="..\tools\modpack-manager\patches\update-*.json" Link="modpack-patches\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- One list of known servers for LadsCore and the launcher (ServerNameResolver, Servers tab). -->
    <EmbeddedResource Include="..\TheLadsCore\common\src\main\resources\thelads\known_servers.json" Link="Services\known_servers.json" LogicalName="known_servers.json" />
  </ItemGroup>

  <!-- The CurseForge API key built into the launcher: LADS_CURSEFORGE_API_KEY (environment variable or CI secret) at build time.
       Without it CurseForge works only with a key entered in Mod Manager Settings. See docs/CURSEFORGE_API_KEY.md. -->
  <ItemGroup Condition="'$(LADS_CURSEFORGE_API_KEY)' != ''">
    <AssemblyMetadata Include="CurseForgeApiKey" Value="$(LADS_CURSEFORGE_API_KEY)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <!-- Reads the Modrinth App's app.db for Modpacks ▸ External. winsqlite3 is Windows' own SQLite: no native dll is shipped. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.11" />
    <PackageReference Include="Microsoft.Identity.Client.Desktop" Version="4.84.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_winsqlite3" Version="2.1.10" />
    <PackageReference Include="Velopack" Version="1.2.158" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
  </ItemGroup>

  <!-- LadsUpdateBridge.exe (net462) next to the launcher in build and publish output; not referenced as an assembly.
       RuntimeIdentifier/SelfContained from a self-contained win-x64 publish must not reach the .NET Framework project. -->
  <ItemGroup>
    <ProjectReference Include="..\TheLadsLauncher.UpdateBridge\TheLadsLauncher.UpdateBridge.csproj" ReferenceOutputAssembly="false" PrivateAssets="all"
                      SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" OutputItemType="LadsUpdateBridge" />
  </ItemGroup>
  <Target Name="AddLadsUpdateBridge" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <ContentWithTargetPath Include="@(LadsUpdateBridge)" TargetPath="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
