<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TheLadsLauncher.Views.ControlsSettingsView">
    <UserControl.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <Style Selector="Button.keybind">
            <Setter Property="Background" Value="#25262A" />
            <Setter Property="Foreground" Value="#E0E0E4" />
            <Setter Property="BorderBrush" Value="#3A3B42" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="150" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.keybind.conflict">
            <Setter Property="Foreground" Value="#FF8A8A" />
            <Setter Property="BorderBrush" Value="#E5383B" />
        </Style>
        <Style Selector="Button.keybind.listening">
            <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}" />
            <Setter Property="Foreground" Value="{DynamicResource LadsAccent}" />
        </Style>
    </UserControl.Styles>
    <ScrollViewer>
        <StackPanel Spacing="16">
            <Border Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock Text="PROFILE" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="label" Text="Game settings of" />
                        <ComboBox x:Name="ProfilePicker" Grid.Column="1" Width="300" Height="36" SelectionChanged="ProfilePicker_SelectionChanged" />
                    </Grid>
                    <TextBlock x:Name="SourceNote" Foreground="#868994" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock x:Name="WarningNote" Foreground="#E0A458" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </Border>
            <Border x:Name="GameCard" Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock Text="VIDEO &amp; MOUSE" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                    <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="Field of view" /><TextBlock x:Name="FovValue" Grid.Column="1" Classes="value" /></Grid>
                            <Slider x:Name="FovSlider" Minimum="30" Maximum="110" TickFrequency="1" IsSnapToTickEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="Mouse sensitivity" /><TextBlock x:Name="SensitivityValue" Grid.Column="1" Classes="value" /></Grid>
                            <Slider x:Name="SensitivitySlider" Minimum="0" Maximum="200" TickFrequency="1" IsSnapToTickEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="Render distance" /><TextBlock x:Name="RenderDistanceValue" Grid.Column="1" Classes="value" /></Grid>
                            <Slider x:Name="RenderDistanceSlider" Minimum="2" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" />
                        </StackPanel>
                        <StackPanel x:Name="SimulationPanel" Grid.Row="1" Grid.Column="2" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="Simulation distance" /><TextBlock x:Name="SimulationDistanceValue" Grid.Column="1" Classes="value" /></Grid>
                            <Slider x:Name="SimulationDistanceSlider" Minimum="5" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Spacing="2">
                            <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="label" Text="Max frame rate" /><TextBlock x:Name="MaxFpsValue" Grid.Column="1" Classes="value" /></Grid>
                            <Slider x:Name="MaxFpsSlider" Minimum="10" Maximum="260" TickFrequency="10" IsSnapToTickEnabled="True" />
                        </StackPanel>
                        <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <TextBlock Classes="label" Text="GUI scale" />
                            <ComboBox x:Name="GuiScaleBox" Grid.Column="1" Width="140" Height="32" />
                        </Grid>
                        <CheckBox x:Name="VsyncCheck" Grid.Row="3" Content="VSync (sync the frame rate to the monitor)" Margin="0,8,0,0" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border x:Name="KeysCard" Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="KEY BINDS" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                            <TextBlock Text="Click a key, then press the new key or mouse button. Esc unbinds it." Foreground="#868994" FontSize="12" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="action" Content="Reset keys" Height="32" Padding="12,0" VerticalAlignment="Top" ToolTip.Tip="Every key bind on this list back to Minecraft's default" Click="ResetKeys_Click" />
                    </Grid>
                    <TextBlock x:Name="ConflictNote" Foreground="#FF8A8A" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
                    <UniformGrid x:Name="KeyRows" Columns="2" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusLine" Foreground="#A4BAA7" FontSize="12" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
