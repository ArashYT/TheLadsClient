<UserControl xmlns="https://github.com/avaloniaui" xmlns:c="using:TheLadsLauncher.Controls" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TheLadsLauncher.Views.ModpacksView">
  <UserControl.Styles>
    <Style Selector="Button.card">
      <Setter Property="Background" Value="#1B1C20" />
      <Setter Property="BorderBrush" Value="#2A2B31" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,16,16" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.card:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#24252B" />
      <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}" />
    </Style>
    <!-- Loader picker in the New modpack dialog: one chip per loader, the checked one outlined in the accent. -->
    <Style Selector="RadioButton.loaderChip">
      <Setter Property="Background" Value="#1E1F24" />
      <Setter Property="BorderBrush" Value="#2E2F36" />
      <Setter Property="Foreground" Value="#C5C7D0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="6,10">
            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.loaderChip:pointerover">
      <Setter Property="Background" Value="#24252B" />
      <Setter Property="BorderBrush" Value="#4A4B55" />
    </Style>
    <Style Selector="RadioButton.loaderChip:checked">
      <Setter Property="Background" Value="#2A1C1F" />
      <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.loaderChip:focus-visible">
      <Setter Property="BorderBrush" Value="#E6E7EC" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <!-- My Modpacks, External Instances and Browse: header, sub-tabs and toolbar laid out as Profiles and Servers. -->
    <Grid x:Name="LibraryPanel" RowDefinitions="Auto,Auto,Auto,*" Margin="28,24,28,12">
      <StackPanel Spacing="4">
        <TextBlock Classes="pageTitle" Text="Modpacks" />
        <TextBlock Classes="pageSubtitle" Text="Each modpack is its own instance with its own mods, worlds and settings; your Lads profiles stay as they are. The Lads Core is added wherever it is supported." />
      </StackPanel>
      <TabControl x:Name="Tabs" Classes="pills" Padding="0" Grid.Row="1" Margin="0,16,0,0" HorizontalAlignment="Left" SelectionChanged="Tabs_Changed">
        <TabItem x:Name="MineTab" Header="My Modpacks" />
        <TabItem x:Name="ExternalTab" Header="Other Launchers" />
        <TabItem x:Name="BrowseTab" Header="Browse" />
      </TabControl>
      <Grid Grid.Row="2" Margin="0,12,0,12">
        <Grid x:Name="MineToolbar" ColumnDefinitions="*,160,140,Auto,Auto">
          <TextBox x:Name="MineSearch" Height="34" PlaceholderText="Search my modpacks…" VerticalContentAlignment="Center" Margin="0,0,8,0" TextChanged="MineFilter_Changed" />
          <ComboBox x:Name="MineSort" Grid.Column="1" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="MineFilter_Changed" />
          <ComboBox x:Name="MineLoader" Grid.Column="2" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="MineFilter_Changed" />
          <Button c:Ico.Name="file-import" Grid.Column="3" Classes="action" Content="Import…" ToolTip.Tip="Import a Modrinth .mrpack or CurseForge .zip" Height="34" Margin="0,0,8,0" Click="Import_Click" />
          <Button c:Ico.Name="plus" Grid.Column="4" Classes="launch" Content="New Modpack" Height="34" Padding="16,0" Foreground="White" FontWeight="Bold" Click="Create_Click" />
        </Grid>
        <Grid x:Name="ExternalToolbar" ColumnDefinitions="*,160,160,Auto,Auto" IsVisible="False">
          <TextBox x:Name="ExternalSearch" Height="34" PlaceholderText="Search instances from other launchers…" VerticalContentAlignment="Center" Margin="0,0,8,0" TextChanged="ExternalFilter_Changed" />
          <ComboBox x:Name="ExternalLauncherFilter" Grid.Column="1" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="ExternalFilter_Changed" />
          <ComboBox x:Name="ExternalSort" Grid.Column="2" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="ExternalFilter_Changed" />
          <Button c:Ico.Name="refresh" Grid.Column="3" Classes="action" Content="Rescan" Height="34" Margin="0,0,8,0" Click="RescanExternal_Click" />
          <Button c:Ico.Name="add-folder" Grid.Column="4" Classes="action" Content="Add folder" Height="34" Click="AddExternalFolder_Click" />
        </Grid>
        <Grid x:Name="BrowseToolbar" ColumnDefinitions="*,130,130,150,Auto" IsVisible="False">
          <TextBox x:Name="BrowseSearch" Height="34" PlaceholderText="Search Modrinth modpacks…" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="BrowseSearch_KeyDown" />
          <ComboBox x:Name="BrowseVersion" Grid.Column="1" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="BrowseFilter_Changed" />
          <ComboBox x:Name="BrowseLoader" Grid.Column="2" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="BrowseFilter_Changed" />
          <ComboBox x:Name="BrowseSort" Grid.Column="3" Height="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="BrowseFilter_Changed" />
          <Button c:Ico.Name="search" Grid.Column="4" Classes="action" Content="Search" Height="34" Click="BrowseSearch_Click" />
        </Grid>
      </Grid>
      <Grid Grid.Row="3" RowDefinitions="Auto,*">
        <TextBlock x:Name="Status" Foreground="#A0A1AA" TextWrapping="Wrap" Margin="0,0,0,10" />
        <ScrollViewer x:Name="MineScroll" Grid.Row="1"><StackPanel x:Name="Cards" Spacing="8" /></ScrollViewer>
        <ScrollViewer x:Name="ExternalScroll" Grid.Row="1" IsVisible="False">
          <WrapPanel x:Name="ExternalCards" />
        </ScrollViewer>
        <ScrollViewer x:Name="BrowseScroll" Grid.Row="1" IsVisible="False">
          <StackPanel>
            <StackPanel x:Name="Results" Spacing="8" />
            <Button c:Ico.Name="arrow-small-down" x:Name="MoreButton" Classes="action" Content="Load more" HorizontalAlignment="Center" Margin="0,10" IsVisible="False" Click="More_Click" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- One instance -->
    <Grid x:Name="ManagePanel" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="24,18,24,12">
      <!-- Top Header Area -->
      <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,4">
        <!-- Top bar: Back button + Title actions -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
          <Button c:Ico.Name="arrow-small-left" Classes="action" Content="Modpacks" Height="32" Padding="12,0" VerticalAlignment="Center" Click="Back_Click" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="icon" ToolTip.Tip="Open modpack folder" Width="34" Height="34" Click="OpenFolder_Click" c:Ico.Name="folder-open" />
            <Button Classes="icon" ToolTip.Tip="Instance RAM &amp; Settings" Width="34" Height="34" Click="OpenSettings_Click" c:Ico.Name="settings" />
            <Button x:Name="DeleteButton" Classes="icon danger" ToolTip.Tip="Delete Modpack" Width="34" Height="34" Click="Delete_Click" c:Ico.Name="trash" />
          </StackPanel>
        </Grid>

        <!-- Instance Main Info Card / Header -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <Border x:Name="ManageArt" Width="82" Height="82" CornerRadius="8" ClipToBounds="True" Margin="0,0,16,0" BorderBrush="#2D2F37" BorderThickness="1" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock x:Name="ManageTitle" Classes="notranslate" FontSize="22" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ManageByline" Foreground="#9CA0AB" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Pack version (Modrinth packs) -->
            <StackPanel x:Name="ManageVersionRow" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <Border x:Name="ManageReleaseBadge" Classes="chip good" Padding="6,1" Height="19" VerticalAlignment="Center">
                <TextBlock Text="R" FontSize="10" FontWeight="Bold" Foreground="#7FD99A" />
              </Border>
              <TextBlock x:Name="ManageVersionText" Foreground="#C5C7D0" FontSize="11.5" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Version and loader as chips (as on Profiles), then when it was played -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
              <Border Classes="chip"><TextBlock x:Name="ManageMcVersion" /></Border>
              <Border Classes="chip"><TextBlock x:Name="ManageLoader" /></Border>
              <TextBlock x:Name="ManageLastPlayed" Classes="muted" VerticalAlignment="Center" Margin="4,0,0,0" />
              <TextBlock x:Name="ManagePlaytime" Classes="muted" VerticalAlignment="Center" />
              <TextBlock x:Name="ManageCreated" Classes="muted" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- The page's one primary button -->
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6" HorizontalAlignment="Right">
            <Button c:Ico.Name="play" x:Name="PlayButton" Classes="launch" Content="Play" MinWidth="130" Height="40" Foreground="White" FontWeight="Bold" HorizontalContentAlignment="Center" Click="Play_Click" />
          </StackPanel>
        </Grid>
      </Grid>

      <TextBlock x:Name="ManageStatus" Grid.Row="1" Foreground="#A0A1AA" TextWrapping="Wrap" Margin="0,0,0,6" />

      <!-- Primary Tab Strip with + Add Content -->
      <Grid Grid.Row="2" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TabControl x:Name="InstanceTabs" Classes="pills" Padding="0" SelectionChanged="InstanceTabs_SelectionChanged">
            <TabItem x:Name="TabOverview" Header="Overview" />
            <TabItem x:Name="TabContent" Header="Content (0)" />
            <TabItem x:Name="TabLogs" Header="Logs" />
            <TabItem x:Name="TabScreenshots" Header="Screenshots" />
          </TabControl>
          <Button c:Ico.Name="plus" x:Name="HeaderAddContentButton" Grid.Column="1" Classes="action" Content="Add Content" Height="34" Padding="16,0" FontWeight="SemiBold" VerticalAlignment="Center" Click="AddMods_Click" />
        </Grid>

        <!-- Main Tab Contents -->
        <Grid Grid.Row="1">
          <!-- 1. Overview Tab -->
          <ScrollViewer x:Name="OverviewPanel" IsVisible="True" Margin="0,8,0,0">
            <StackPanel Spacing="16" MaxWidth="740" HorizontalAlignment="Left">
              <!-- Memory Allocation Card -->
              <Border Classes="card">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="sectionTitle" Text="MEMORY ALLOCATION" />
                      <TextBlock Classes="muted" Text="Dedicated RAM for this instance (0 = uses global launcher setting)." />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="chip accent" VerticalAlignment="Top">
                      <TextBlock x:Name="RamDisplay" FontWeight="Bold" FontSize="13" Text="Default" />
                    </Border>
                  </Grid>

                  <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <Slider x:Name="RamSlider" Minimum="0" Maximum="32" Value="0" SmallChange="0.5" LargeChange="1.0"
                            ValueChanged="RamSlider_ValueChanged" VerticalAlignment="Center" />
                    <NumericUpDown x:Name="RamBox" Grid.Column="1" ShowButtonSpinner="False" Width="110" Height="34" Background="#141519" BorderBrush="#2A2B31" CornerRadius="6" Minimum="0" Maximum="65536" Increment="512"
                                   FormatString="0 MB" Margin="14,0,0,0" ValueChanged="RamBox_ValueChanged" />
                  </Grid>

                  <WrapPanel Margin="0,2,0,0">
                    <Button c:Ico.Name="memory" Classes="action" Content="Default (0)" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="RamPreset_Click" Tag="0" />
                    <Button c:Ico.Name="memory" Classes="action" Content="4 GB" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="RamPreset_Click" Tag="4096" />
                    <Button c:Ico.Name="memory" Classes="action" Content="6 GB" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="RamPreset_Click" Tag="6144" />
                    <Button c:Ico.Name="memory" Classes="action" Content="8 GB" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="RamPreset_Click" Tag="8192" />
                    <Button c:Ico.Name="memory" Classes="action" Content="12 GB" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="RamPreset_Click" Tag="12288" />
                    <Button c:Ico.Name="memory" Classes="action" Content="16 GB" FontSize="11" Padding="8,4" Margin="0,0,6,6" Click="RamPreset_Click" Tag="16384" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Instance Identity Card -->
              <Border Classes="card">
                <StackPanel Spacing="14">
                  <TextBlock Classes="sectionTitle" Text="INSTANCE SETTINGS" />
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <TextBox x:Name="NameBox" PlaceholderText="Instance Name" Height="34" VerticalContentAlignment="Center" />
                    <Button c:Ico.Name="picture" Grid.Column="1" Classes="action" Content="Change icon" Height="34" Margin="8,0,0,0" Click="Icon_Click" />
                  </Grid>

                  <Border Height="1" Background="#2A2B31" Margin="0,2" />

                  <!-- Lads Core Setting -->
                  <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                      <TextBlock Text="Lads Core" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                      <TextBlock Classes="muted" Text="Adds The Lads Client mod (HUD, modules, performance) to this modpack" TextWrapping="Wrap" />
                      <TextBlock x:Name="LadsCoreUnsupportedReason" Classes="muted" Foreground="#E06C75" FontSize="11" IsVisible="False" TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <ToggleSwitch x:Name="LadsCoreToggle" Grid.Column="1" Classes="cfSwitch" VerticalAlignment="Center" Margin="14,0,0,0" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Pack Version / Updates Card (if from Modrinth) -->
              <Border x:Name="UpdateCard" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="sectionTitle" Text="PACK VERSION &amp; UPDATES" />
                  <TextBlock Classes="muted" Text="Updating keeps your worlds, custom options, and manually added mods." />
                  <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                    <ComboBox x:Name="VersionBox" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                    <Button c:Ico.Name="download" x:Name="UpdateButton" Grid.Column="1" Classes="action" Content="Install this version" Click="Update_Click" />
                  </Grid>
                </StackPanel>
              </Border>

              <!-- Save Actions -->
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,20">
                <Button c:Ico.Name="disk" Classes="launch" Content="Save changes" Height="36" Padding="20,0" Click="Save_Click" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- 2. Content Tab (CurseForge sub-tabs and table) -->
          <Grid x:Name="ContentPanel" IsVisible="False" RowDefinitions="Auto,Auto,*" Margin="0,6,0,0">
            <!-- Secondary Subtabs (Mods, Data Packs, Resource Packs, Shaders, Worlds) -->
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,0,10">
              <Button c:Ico.Name="puzzle-piece" x:Name="SubTabModsBtn" Classes="action" Content="Mods (0)" Height="30" Padding="12,0" FontWeight="SemiBold" Click="SubTab_Click" Tag="mods" />
              <Button c:Ico.Name="box" x:Name="SubTabDatapacksBtn" Classes="action" Content="Data Packs (0)" Height="30" Padding="12,0" FontWeight="SemiBold" Click="SubTab_Click" Tag="datapacks" />
              <Button c:Ico.Name="layers" x:Name="SubTabResourcePacksBtn" Classes="action" Content="Resource Packs (0)" Height="30" Padding="12,0" FontWeight="SemiBold" Click="SubTab_Click" Tag="resourcepacks" />
              <Button c:Ico.Name="sparkles" x:Name="SubTabShadersBtn" Classes="action" Content="Shaders (0)" Height="30" Padding="12,0" FontWeight="SemiBold" Click="SubTab_Click" Tag="shaderpacks" />
              <Button c:Ico.Name="globe" x:Name="SubTabWorldsBtn" Classes="action" Content="Worlds (0)" Height="30" Padding="12,0" FontWeight="SemiBold" Click="SubTab_Click" Tag="worlds" />
            </StackPanel>

            <!-- Content Toolbar (Update all, search, filter, refresh, from file) -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,0,0,10">
              <!-- Update All Button with Count Badge -->
              <Button x:Name="UpdateAllButton" Classes="action" Height="32" Padding="10,0" VerticalAlignment="Center" Click="UpdateAll_Click">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <c:Glyph Kind="refresh" Size="13" VerticalAlignment="Center" /><TextBlock Text="Update all" VerticalAlignment="Center" />
                  <Border x:Name="UpdateAllBadge" Background="{DynamicResource LadsAccent}" CornerRadius="10" MinWidth="18" Height="18" Padding="5,0" VerticalAlignment="Center" IsVisible="False">
                    <TextBlock x:Name="UpdateAllBadgeText" Text="1" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                </StackPanel>
              </Button>

              <TextBlock x:Name="ContentUpdateStatus" Grid.Column="1" Foreground="#8F919C" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />

              <TextBox x:Name="ContentFilterSearch" Grid.Column="2" Width="200" Height="32" PlaceholderText="Search installed..." TextChanged="ContentFilter_Changed" Margin="8,0,0,0" />
              <Button c:Ico.Name="add-document" x:Name="AddFromFileButton" Grid.Column="3" Classes="action" Content="From file" Height="32" Margin="8,0,0,0" Click="AddCurrentFromFile_Click" />
              <Button Classes="icon" Grid.Column="4" ToolTip.Tip="Refresh list and check for updates" Width="32" Height="32" Margin="8,0,0,0" Click="RefreshCurrentContent_Click" c:Ico.Name="refresh" />
              <Button Classes="icon" Grid.Column="5" ToolTip.Tip="Open current folder in File Explorer" Width="32" Height="32" Margin="8,0,0,0" Click="OpenCurrentFolder_Click" c:Ico.Name="folder-open" />
            </Grid>

            <!-- Table Area -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
              <!-- Mods Table Header (Screenshot 3 & 4) -->
              <Border x:Name="ModsTableHeader" Background="#141519" BorderBrush="#26272E" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,0,0,4">
                <Grid ColumnDefinitions="34,*,140,140,70,80,44">
                  <CheckBox x:Name="ModsSelectAllBox" VerticalAlignment="Center" IsCheckedChanged="ModsSelectAll_Changed" />
                  <TextBlock Grid.Column="1" Text="Name ▲" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="Action" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="Author" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="Env" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="Active" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="6" Text="" VerticalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Generic Header for Resource Packs / Shaders / Datapacks -->
              <Border x:Name="GenericTableHeader" IsVisible="False" Background="#141519" BorderBrush="#26272E" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,0,0,4">
                <Grid ColumnDefinitions="*,100,60">
                  <TextBlock x:Name="GenericHeaderTitle" Text="Name" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock x:Name="GenericHeaderStatus" Grid.Column="1" Text="Active" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="Delete" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Dedicated Worlds Table Header -->
              <Border x:Name="WorldsTableHeader" IsVisible="False" Background="#141519" BorderBrush="#26272E" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,0,0,4">
                <Grid ColumnDefinitions="*,140,80,60">
                  <TextBlock Text="World Name" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Last Played" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="Folder" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="Delete" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
              </Border>

              <ScrollViewer Grid.Row="1">
                <StackPanel>
                  <!-- Mods Table List -->
                  <StackPanel x:Name="ModsList" Spacing="4" />
                  <!-- Data Packs List -->
                  <StackPanel x:Name="DatapacksList" Spacing="4" IsVisible="False" />
                  <!-- Resource Packs List -->
                  <StackPanel x:Name="ResourcePacksList" Spacing="4" IsVisible="False" />
                  <!-- Shaders List -->
                  <StackPanel x:Name="ShadersList" Spacing="4" IsVisible="False" />
                  <!-- Worlds List -->
                  <StackPanel x:Name="WorldsList" Spacing="4" IsVisible="False" />

                  <!-- Compatibility hidden elements for existing code -->
                  <TextBlock x:Name="ModsHeader" IsVisible="False" />
                  <TextBox x:Name="ModsSearch" IsVisible="False" />
                  <TextBlock x:Name="ResourcePacksHeader" IsVisible="False" />
                  <TextBox x:Name="ResourcePacksSearch" IsVisible="False" />
                  <TextBlock x:Name="ShadersHeader" IsVisible="False" />
                  <TextBox x:Name="ShadersSearch" IsVisible="False" />
                  <TextBlock x:Name="DatapacksHeader" IsVisible="False" />
                  <TextBox x:Name="DatapacksSearch" IsVisible="False" />
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Grid>

          <!-- 3. Logs Tab -->
          <Grid x:Name="LogsPanel" IsVisible="False" RowDefinitions="Auto,*" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,10">
              <TextBlock Text="latest.log" FontWeight="SemiBold" FontSize="13" Foreground="#C5C7D0" VerticalAlignment="Center" />
              <TextBox x:Name="LogsFilterBox" Grid.Column="1" Width="200" Height="30" PlaceholderText="Filter log..." Margin="8,0,0,0" TextChanged="LogsFilter_Changed" />
              <Button c:Ico.Name="copy" Grid.Column="2" Classes="action" Content="Copy all" Height="30" Margin="8,0,0,0" Click="CopyLog_Click" />
              <Button c:Ico.Name="edit" Grid.Column="3" Classes="action" Content="Open in Editor" Height="30" Margin="8,0,0,0" Click="OpenLogFile_Click" />
            </Grid>
            <Border Grid.Row="1" Background="#111215" BorderBrush="#26272E" BorderThickness="1" CornerRadius="6" Padding="12">
              <ScrollViewer x:Name="LogsScroll">
                <SelectableTextBlock x:Name="LogsText" FontFamily="Consolas,Menlo,Monospace" FontSize="11.5" Foreground="#D5D7E0" TextWrapping="Wrap" />
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- 4. Screenshots Tab -->
          <Grid x:Name="ScreenshotsPanel" IsVisible="False" RowDefinitions="Auto,*" Margin="0,8,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
              <TextBlock x:Name="ScreenshotsHeader" Text="SCREENSHOTS" FontWeight="SemiBold" FontSize="13" Foreground="#C5C7D0" VerticalAlignment="Center" />
              <Button c:Ico.Name="folder-open" Grid.Column="1" Classes="action" Content="Open screenshots folder" Height="30" Click="OpenScreenshotsFolder_Click" />
            </Grid>
            <ScrollViewer Grid.Row="1">
              <WrapPanel x:Name="ScreenshotsGallery" />
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- + Create Modal -->
    <Border x:Name="CreatePanel" IsVisible="False" Background="#CC000000" PointerPressed="CreateBackdrop_PointerPressed">
      <Border x:Name="CreateCard" Background="#17181B" BorderBrush="#303137" BorderThickness="1" CornerRadius="12" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" KeyDown="CreateCard_KeyDown">
        <Grid RowDefinitions="Auto,Auto,Auto">
          <!-- Header: live preview of the pack's art, title, close -->
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="22,20,16,0">
            <Border x:Name="CreatePreviewArt" Width="56" Height="56" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Spacing="3" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="New modpack" FontSize="18" FontWeight="Bold" Foreground="White" />
              <TextBlock Text="Its own mods, worlds and settings." Foreground="#9CA0AB" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" Width="32" Height="32" VerticalAlignment="Top" c:Ico.Name="cross-small" ToolTip.Tip="Close" AutomationProperties.Name="Close" Click="CreateCancel_Click" />
          </Grid>

          <!-- Fields -->
          <StackPanel Grid.Row="1" Spacing="6" Margin="22,20,22,0">
            <TextBlock Classes="caption" Text="NAME" />
            <TextBox x:Name="CreateName" Height="36" VerticalContentAlignment="Center" PlaceholderText="e.g. Survival with friends" MaxLength="64" TextChanged="CreateInput_Changed" AutomationProperties.Name="Modpack name" />
            <TextBlock x:Name="CreateNameError" Foreground="#E06C75" FontSize="11.5" IsVisible="False" Text="Give the modpack a name." />

            <TextBlock Classes="caption" Text="MINECRAFT VERSION" Margin="0,10,0,0" />
            <ComboBox x:Name="CreateVersion" Height="36" HorizontalAlignment="Stretch" SelectionChanged="CreateInput_Changed" AutomationProperties.Name="Minecraft version" />

            <TextBlock Classes="caption" Text="MOD LOADER" Margin="0,10,0,0" />
            <UniformGrid x:Name="CreateLoaderChips" Rows="1" />
          </StackPanel>

          <!-- Summary, status and actions -->
          <Border Grid.Row="2" Margin="0,22,0,0" Padding="22,14" Background="#131417" BorderBrush="#26272E" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="CreateSummary" Foreground="#E6E7EC" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CreateCoreNote" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="CreateStatus" Foreground="#FFC07D" FontSize="11.5" TextWrapping="Wrap" IsVisible="False" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Classes="action" Content="Cancel" Height="36" Padding="16,0" Click="CreateCancel_Click" />
                <Button c:Ico.Name="plus" x:Name="CreateConfirm" Classes="launch" Content="Create" Height="36" Padding="20,0" Foreground="White" FontWeight="Bold" Click="CreateConfirm_Click" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Border>

    <!-- Add Content Modal (CurseForge style browser - Screenshot 2) -->
    <Border x:Name="AddContentPanel" IsVisible="False" Background="#FF0D0E11">
      <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="32,20,32,18">
        <!-- Top bar: Instance header + close X button -->
        <Grid ColumnDefinitions="Auto,*,Auto">
          <Border x:Name="AddContentArt" Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock x:Name="AddContentTitle" FontSize="18" FontWeight="Bold" Foreground="White" />
            <TextBlock x:Name="AddContentSubtitle" FontSize="11.5" Foreground="#A0A1AA" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon" Width="36" Height="36" Click="AddContentBack_Click" ToolTip.Tip="Close browser" c:Ico.Name="cross-small" />
        </Grid>

        <!-- Search input box -->
        <Grid Grid.Row="1" Margin="0,14,0,8">
          <TextBox x:Name="AddContentSearchBox" Height="38" FontSize="13" PlaceholderText="Search for mods..." KeyDown="AddContentSearch_KeyDown" />
        </Grid>

        <!-- Filter pills + Dropdown Controls (Kind, Provider, Sort, Category) -->
        <Grid Grid.Row="2" RowDefinitions="Auto,Auto" Margin="0,0,0,12">
          <!-- Active filter pills (Loader, Game Version) -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
            <Border x:Name="AddContentLoaderPill" Classes="chip" Padding="10,4" Background="#24252C">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="AddContentLoaderPillText" Text="Fabric" FontSize="11" Foreground="#C5C7D0" FontWeight="SemiBold" />
                <c:Glyph Kind="cross-small" Size="12" Foreground="#8F919C" Cursor="Hand" PointerPressed="ClearLoaderFilter_Click" ToolTip.Tip="Clear filter" />
              </StackPanel>
            </Border>
            <Border x:Name="AddContentVersionPill" Classes="chip" Padding="10,4" Background="#24252C">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock x:Name="AddContentVersionPillText" Text="26.3" FontSize="11" Foreground="#C5C7D0" FontWeight="SemiBold" />
                <c:Glyph Kind="cross-small" Size="12" Foreground="#8F919C" Cursor="Hand" PointerPressed="ClearVersionFilter_Click" ToolTip.Tip="Clear filter" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Controls bar (Kind dropdown, count, sort, categories, search button) -->
          <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
            <ComboBox x:Name="AddContentKindBox" Width="140" Height="34" SelectionChanged="AddContentKind_Changed">
              <ComboBoxItem Content="Mods" />
              <ComboBoxItem Content="Data Packs" />
              <ComboBoxItem Content="Resource Packs" />
              <ComboBoxItem Content="Shaders" />
            </ComboBox>

            <TextBlock x:Name="AddContentResultsCount" Grid.Column="1" Text="Projects found" Foreground="#8F919C" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0" />

            <CheckBox x:Name="AddContentHideInstalled" Grid.Column="2" Content="Hide installed" VerticalAlignment="Center" Margin="12,0,0,0" IsCheckedChanged="AddContentHideInstalled_Changed" />
            <ComboBox x:Name="AddContentProvider" SelectedIndex="0" Grid.Column="3" Width="110" Height="34" Margin="8,0,0,0" SelectionChanged="AddContentFilter_Changed">
              <ComboBoxItem Content="Modrinth" />
              <ComboBoxItem Content="CurseForge" />
            </ComboBox>
            <ComboBox x:Name="AddContentSort" SelectedIndex="0" Grid.Column="4" Width="160" Height="34" Margin="8,0,0,0" SelectionChanged="AddContentFilter_Changed">
              <ComboBoxItem Content="Most downloads" />
              <ComboBoxItem Content="Relevance" />
              <ComboBoxItem Content="Most follows" />
              <ComboBoxItem Content="Newest" />
              <ComboBoxItem Content="Recently updated" />
            </ComboBox>
            <ComboBox x:Name="AddContentCategory" Grid.Column="5" Width="130" Height="34" Margin="8,0,0,0" SelectionChanged="AddContentFilter_Changed" />
            <Button c:Ico.Name="search" Grid.Column="6" Classes="action" Content="Search" Height="34" Margin="8,0,0,0" Click="AddContentSearch_Click" />
          </Grid>
        </Grid>

        <!-- Search Results list -->
        <Grid Grid.Row="3" RowDefinitions="Auto,*">
          <TextBlock x:Name="AddContentStatus" Foreground="#A0A1AA" Margin="0,0,0,8" />
          <ScrollViewer x:Name="AddContentScroll" Grid.Row="1" ScrollChanged="AddContentScroll_Changed">
            <StackPanel>
              <StackPanel x:Name="AddContentResults" Spacing="8" />
              <Button c:Ico.Name="arrow-small-down" x:Name="AddContentMoreButton" Classes="action" Content="Load more" HorizontalAlignment="Center" Margin="0,12" IsVisible="False" Click="AddContentMore_Click" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>

    <!-- Mod Details & Version Picker Modal (CurseForge style - Screenshot 1) -->
    <Border x:Name="ModDetailsPanel" IsVisible="False" Background="#FF0D0E11">
      <Grid RowDefinitions="Auto,Auto,*" Margin="32,20,32,18">
        <!-- Top breadcrumb bar -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,14">
          <Button c:Ico.Name="arrow-small-left" Classes="action" Content="Back" Height="32" Padding="12,0" Click="ModDetailsBack_Click" />
          <TextBlock x:Name="ModDetailsBreadcrumb" Grid.Column="1" Foreground="#8F919C" FontSize="12.5" VerticalAlignment="Center" Margin="14,0,0,0" />
          <Button Grid.Column="2" Classes="icon" Width="34" Height="34" Click="ModDetailsBack_Click" c:Ico.Name="cross-small" />
        </Grid>

        <!-- Mod Details Header (Icon, Title, Byline, Summary, Tags, Action Button) -->
        <Border Grid.Row="1" Background="#16171B" BorderBrush="#2A2B33" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border x:Name="ModDetailsIcon" Width="72" Height="72" CornerRadius="8" ClipToBounds="True" Background="#24252B" Margin="0,0,16,0" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="4">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="ModDetailsTitle" FontSize="20" FontWeight="Bold" Foreground="White" />
                <TextBlock x:Name="ModDetailsAuthor" Foreground="#A0A1AA" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="ModDetailsSummary" Foreground="#C9CAD1" FontSize="12" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
              <WrapPanel x:Name="ModDetailsTags" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
              <Button c:Ico.Name="download" x:Name="ModDetailsActionBtn" Classes="cfInstall" Content="Install" MinWidth="110" Height="38" HorizontalContentAlignment="Center" Click="ModDetailsAction_Click" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Details Tabs: Overview & Versions -->
        <Grid Grid.Row="2" RowDefinitions="Auto,*">
          <TabControl x:Name="ModDetailsTabs" Classes="pills" Padding="0" Margin="0,0,0,10" SelectionChanged="ModDetailsTabs_Changed">
            <TabItem x:Name="ModDetailsOverviewTab" Header="Overview" />
            <TabItem x:Name="ModDetailsVersionsTab" Header="Versions" />
          </TabControl>

          <Grid Grid.Row="1">
            <!-- Overview Body / Description -->
            <ScrollViewer x:Name="ModDetailsOverviewView" IsVisible="True">
              <Border Background="#16171B" BorderBrush="#26272E" BorderThickness="1" CornerRadius="8" Padding="18">
                <SelectableTextBlock x:Name="ModDetailsBody" Foreground="#D5D7E0" FontSize="12.5" TextWrapping="Wrap" />
              </Border>
            </ScrollViewer>

            <!-- Versions Table View (Screenshot 1) -->
            <Grid x:Name="ModDetailsVersionsView" IsVisible="False" RowDefinitions="Auto,Auto,*">
              <!-- Filter / Controls row -->
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBlock x:Name="ModDetailsVersionsStatus" Foreground="#8F919C" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Show incompatible versions" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <ToggleSwitch x:Name="ModDetailsIncompatibleToggle" Classes="cfSwitch" IsChecked="False" IsCheckedChanged="ModDetailsIncompatible_Changed" />
                </StackPanel>
              </Grid>

              <!-- Versions Table Header -->
              <Border Grid.Row="1" Background="#141519" BorderBrush="#26272E" BorderThickness="0,0,0,1" Padding="12,8" Margin="0,0,0,4">
                <Grid ColumnDefinitions="50,*,120,100,100,110">
                  <TextBlock Text="Type" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Name" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="Release Date" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="Modloader" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="4" Text="Game Ver" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="5" Text="Action" FontWeight="SemiBold" FontSize="12" Foreground="#8F919C" VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Grid>
              </Border>

              <!-- Versions List -->
              <ScrollViewer Grid.Row="2">
                <StackPanel x:Name="ModDetailsVersionsList" Spacing="4" />
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
