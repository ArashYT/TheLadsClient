<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TheLadsLauncher.Views.PackBrowserView">
  <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
    <WrapPanel>
      <TextBlock Text="Install to" Foreground="#A0A1AA" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,8" />
      <ComboBox x:Name="TargetBox" Classes="notranslate" Width="340" Height="34" Margin="0,0,8,8" SelectionChanged="Target_Changed" ToolTip.Tip="A Lads version (worlds and packs are shared by every Lads version) or a modpack instance" />
      <TextBlock x:Name="WorldLabel" Text="World" IsVisible="False" Foreground="#A0A1AA" FontSize="13" VerticalAlignment="Center" Margin="4,0,8,8" />
      <ComboBox x:Name="WorldBox" Classes="notranslate" Width="200" Height="34" Margin="0,0,8,8" IsVisible="False" SelectionChanged="World_Changed" />
      <Button Classes="action" Content="Open folder" Height="34" Padding="12,0" Margin="0,0,8,8" HorizontalContentAlignment="Center" Click="OpenFolder_Click" />
      <Button Classes="action" Content="Refresh" Height="34" Padding="12,0" Margin="0,0,8,8" HorizontalContentAlignment="Center" Click="Refresh_Click" />
    </WrapPanel>
    <TextBlock x:Name="Status" Grid.Row="1" Foreground="#A0A1AA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
    <Grid Grid.Row="2" ColumnDefinitions="2*,16,3*">
      <Grid RowDefinitions="Auto,*">
        <TextBlock x:Name="InstalledHeader" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,8" />
        <ScrollViewer Grid.Row="1">
          <StackPanel x:Name="InstalledList" Spacing="6" />
        </ScrollViewer>
      </Grid>
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBox x:Name="SearchBox" Height="34" FontSize="13" Margin="0,0,8,0" TextChanged="Search_TextChanged" />
          <ComboBox x:Name="SourceBox" Grid.Column="1" Width="120" Height="34" SelectedIndex="0" SelectionChanged="Source_Changed">
            <ComboBoxItem Content="Modrinth" />
            <ComboBoxItem Content="CurseForge" />
          </ComboBox>
        </Grid>
        <ScrollViewer Grid.Row="1">
          <StackPanel x:Name="ResultsList" Spacing="6" />
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
