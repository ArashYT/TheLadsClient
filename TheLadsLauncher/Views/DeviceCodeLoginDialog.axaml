<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="380"
        x:Class="TheLadsLauncher.Views.DeviceCodeLoginDialog"
        Title="Microsoft Account Sign-In"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#1D1E22">



    <Border Padding="24" Background="#1D1E22" BorderBrush="#303137" BorderThickness="1" CornerRadius="4">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
                <TextBlock Text="Microsoft Account Sign-In" Foreground="White" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Complete Microsoft sign-in in your browser" Foreground="#A0A1AA" FontSize="12"/>
            </StackPanel>

            <!-- Content Card -->
            <Border Grid.Row="1" Background="#121315" CornerRadius="4" Padding="16" BorderBrush="#303137" BorderThickness="1">
                <StackPanel Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="1. Your sign-in code has been generated:" Foreground="#CCCCCC" FontSize="13"/>

                    <!-- Code Display Box -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Background="#12121E" CornerRadius="4" BorderBrush="#C44343" BorderThickness="1" Padding="12">
                            <SelectableTextBlock x:Name="UserCodeText" Classes="notranslate" Text="XXXX-XXXX"
                                       Foreground="#FFD700" FontSize="22" FontWeight="Bold"
                                       FontFamily="Consolas, monospace"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       LetterSpacing="1"/>
                        </Border>
                        <Button Grid.Column="1" x:Name="CopyCodeBtn" Content="Copy code" Margin="8,0,0,0" VerticalAlignment="Center" Click="CopyCode_Click"/>
                    </Grid>

                    <TextBlock Text="2. Go to the Microsoft verification link:" Foreground="#CCCCCC" FontSize="13"/>

                    <!-- The link as text too: sign-in still works when no browser opens -->
                    <Grid ColumnDefinitions="*,Auto">
                        <SelectableTextBlock x:Name="VerificationUrlText" Classes="notranslate" Text="https://microsoft.com/link"
                                             Foreground="#8AB4F8" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="CopyLinkBtn" Content="Copy link" Margin="8,0,0,0" VerticalAlignment="Center" Click="CopyLink_Click"/>
                    </Grid>

                    <!-- Open Browser Button -->
                    <Button x:Name="OpenBrowserBtn" Classes="launch" Content="Open Link &amp; Copy Code to Browser"
                            Height="40" FontSize="13" Click="OpenBrowser_Click"/>

                    <TextBlock x:Name="StatusLabel" Text="⏳ Waiting for you to complete sign-in in browser..."
                               Foreground="#00FF88" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Bottom Actions -->
            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                <TextBlock Text="This window closes automatically once signed in." Foreground="#90929D" FontSize="11" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="CancelBtn" Classes="danger" Content="Cancel" Width="90" Height="34" Click="Cancel_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
