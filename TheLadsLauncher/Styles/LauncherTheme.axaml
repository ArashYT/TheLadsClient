<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="LadsAccent">#C44343</SolidColorBrush>
    <SolidColorBrush x:Key="LadsAccentHover">#D65353</SolidColorBrush>
    <SolidColorBrush x:Key="LadsAccentPressed">#A53434</SolidColorBrush>
    <SolidColorBrush x:Key="LadsAccentText">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="LadsAccentSubtle">#241C1D</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="RequestedThemeVariant" Value="Dark"/>
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#E9E9EA"/>
    <Setter Property="Background" Value="#17181B"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.action">
    <Setter Property="Background" Value="#25262A"/>
    <Setter Property="Foreground" Value="#D6D6D9"/>
    <Setter Property="BorderBrush" Value="#37383D"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Window.motion Button">
    <Setter Property="Opacity" Value="0.92" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.motion Button:pointerover, Window.motion Button:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Window.motion Button:pressed">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="Button.action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#303136"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#55565D"/>
  </Style>
  <Style Selector="Button.launch">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFEE4452" Offset="0"/>
        <GradientStop Color="#FFC82333" Offset="0.5"/>
        <GradientStop Color="#FFA71826" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#FFAE323D"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.launch /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 2 10 0 #50D42B38"/>
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.launch:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)"/>
  </Style>
  <Style Selector="Button.launch:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFFF6674" Offset="0"/>
        <GradientStop Color="#FFE83344" Offset="0.5"/>
        <GradientStop Color="#FFC21D2C" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FFFF8A96"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BoxShadow" Value="0 0 22 4 #CCEE3B48, 0 4 12 0 #80FF6B78"/>
  </Style>
  <Style Selector="Button.launch:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>
  <Style Selector="Button.launch:pressed /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFB51826" Offset="0"/>
        <GradientStop Color="#FF8E101C" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FF9E1624"/>
    <Setter Property="BoxShadow" Value="0 0 10 2 #88EE3B48"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#2B2022"/>
    <Setter Property="Foreground" Value="#ED9393"/>
    <Setter Property="BorderBrush" Value="#573438"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#443033"/>
    <Setter Property="Foreground" Value="#FFBBBB"/>
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#999BA3"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="13,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource LadsAccentSubtle}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#25262A"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.window">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#9B9CA3"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="36"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <!-- Title-bar "Update" pill: glossy red, a little larger than the window buttons, with the glow and shine drawn around it. -->
  <Style Selector="Button.updateNow">
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="CornerRadius" Value="15"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#FF8A91"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FF7F87" Offset="0"/>
        <GradientStop Color="#E0525B" Offset="0.48"/>
        <GradientStop Color="#B9303C" Offset="0.52"/>
        <GradientStop Color="#9E2330" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Button.updateNow:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FF979E" Offset="0"/>
        <GradientStop Color="#EE6169" Offset="0.48"/>
        <GradientStop Color="#C93A46" Offset="0.52"/>
        <GradientStop Color="#AE2A37" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FFB0B5"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.updateNow:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#9E2330"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.shortcut">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0,14"/>
  </Style>
  <Style Selector="Button.shortcut:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#202125"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="#8F919B"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="LetterSpacing" Value="1.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="#121315"/>
    <Setter Property="Foreground" Value="#E0E0E4"/>
    <Setter Property="BorderBrush" Value="#3A3B42"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#202125"/>
    <Setter Property="Foreground" Value="#E0E0E4"/>
    <Setter Property="BorderBrush" Value="#3A3B42"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="#B9BAC2"/>
  </Style>
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource LadsAccent}"/>
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource LadsAccent}"/>
    <Setter Property="Background" Value="#303137"/>
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True"/>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Foreground" Value="#A0A1AA"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}"/>
  </Style>
</Styles>
