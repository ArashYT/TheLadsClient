<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <SolidColorBrush x:Key="LadsAccent">#C44343</SolidColorBrush>
    <SolidColorBrush x:Key="LadsAccentHover">#D65353</SolidColorBrush>
    <SolidColorBrush x:Key="LadsAccentPressed">#A53434</SolidColorBrush>
    <SolidColorBrush x:Key="LadsAccentText">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="LadsAccentSubtle">#241C1D</SolidColorBrush>
  </Styles.Resources>
  <Style Selector="Window">
    <Setter Property="RequestedThemeVariant" Value="Dark"/>
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#E9E9EA"/>
    <Setter Property="Background" Value="#17181B"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.action">
    <Setter Property="Background" Value="#25262A"/>
    <Setter Property="Foreground" Value="#D6D6D9"/>
    <Setter Property="BorderBrush" Value="#37383D"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Window.motion Button">
    <Setter Property="Opacity" Value="0.92" />
    <Setter Property="Transitions">
      <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.motion Button:pointerover, Window.motion Button:focus-visible">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Window.motion Button:pressed">
    <Setter Property="Opacity" Value="0.72" />
  </Style>
  <Style Selector="Button.action:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#303136"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#55565D"/>
  </Style>
  <Style Selector="Button.launch">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFEE4452" Offset="0"/>
        <GradientStop Color="#FFC82333" Offset="0.5"/>
        <GradientStop Color="#FFA71826" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#FFAE323D"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.launch /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 2 10 0 #50D42B38"/>
    <Setter Property="Transitions">
      <Transitions>
        <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.25" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.launch:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.04)"/>
  </Style>
  <Style Selector="Button.launch:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFFF6674" Offset="0"/>
        <GradientStop Color="#FFE83344" Offset="0.5"/>
        <GradientStop Color="#FFC21D2C" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FFFF8A96"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BoxShadow" Value="0 0 22 4 #CCEE3B48, 0 4 12 0 #80FF6B78"/>
  </Style>
  <Style Selector="Button.launch:pressed">
    <Setter Property="RenderTransform" Value="scale(0.98)"/>
  </Style>
  <Style Selector="Button.launch:pressed /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFB51826" Offset="0"/>
        <GradientStop Color="#FF8E101C" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FF9E1624"/>
    <Setter Property="BoxShadow" Value="0 0 10 2 #88EE3B48"/>
  </Style>
  <!-- Halloween theme (MainWindow sets the window's "halloween" class): a pumpkin-orange launch button. -->
  <Style Selector="Window.halloween Button.launch">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFEE7A22" Offset="0"/>
        <GradientStop Color="#FFD2600C" Offset="0.5"/>
        <GradientStop Color="#FFA84808" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FFB8560E"/>
  </Style>
  <Style Selector="Window.halloween Button.launch /template/ ContentPresenter">
    <Setter Property="BoxShadow" Value="0 2 10 0 #50F28A2E"/>
  </Style>
  <Style Selector="Window.halloween Button.launch:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFFF9A42" Offset="0"/>
        <GradientStop Color="#FFE8701A" Offset="0.5"/>
        <GradientStop Color="#FFBE560C" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FFFFB46E"/>
    <Setter Property="BoxShadow" Value="0 0 22 4 #CCF28A2E, 0 4 12 0 #808A4FD0"/>
  </Style>
  <Style Selector="Window.halloween Button.launch:pressed /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFB8560E" Offset="0"/>
        <GradientStop Color="#FF8A3E06" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FF9A4808"/>
    <Setter Property="BoxShadow" Value="0 0 10 2 #88F28A2E"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="#2B2022"/>
    <Setter Property="Foreground" Value="#ED9393"/>
    <Setter Property="BorderBrush" Value="#573438"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#443033"/>
    <Setter Property="Foreground" Value="#FFBBBB"/>
  </Style>
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#999BA3"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="13,0"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource LadsAccentSubtle}"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#25262A"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <!-- Title-bar window buttons: a small outline each; the close button fades to red on hover. -->
  <Style Selector="Button.window">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#9B9CA3"/>
    <Setter Property="BorderBrush" Value="#34353B"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="30"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CornerRadius" Value="5"/>
  </Style>
  <Style Selector="Button.window:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#25262A"/>
    <Setter Property="BorderBrush" Value="#55565D"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.window.close">
    <Setter Property="Background" Value="#00E5383B"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style Selector="Window.motion Button.window.close /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.2" Easing="CubicEaseOut"/>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.2" Easing="CubicEaseOut"/>
        <BrushTransition Property="Foreground" Duration="0:0:0.2" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.window.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E5383B"/>
    <Setter Property="BorderBrush" Value="#FF6B6E"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.window.close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#B8272A"/>
  </Style>
  <!-- Title-bar "Update" pill: glossy red, a little larger than the window buttons, with the glow and shine drawn around it. -->
  <Style Selector="Button.updateNow">
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="16,0"/>
    <Setter Property="CornerRadius" Value="15"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#FF8A91"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FF7F87" Offset="0"/>
        <GradientStop Color="#E0525B" Offset="0.48"/>
        <GradientStop Color="#B9303C" Offset="0.52"/>
        <GradientStop Color="#9E2330" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
  </Style>
  <Style Selector="Button.updateNow:pointerover /template/ ContentPresenter">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FF979E" Offset="0"/>
        <GradientStop Color="#EE6169" Offset="0.48"/>
        <GradientStop Color="#C93A46" Offset="0.52"/>
        <GradientStop Color="#AE2A37" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#FFB0B5"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.updateNow:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="#9E2330"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.shortcut">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="0,14"/>
  </Style>
  <Style Selector="Button.shortcut:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#202125"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="Foreground" Value="#8F919B"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="LetterSpacing" Value="1.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="#121315"/>
    <Setter Property="Foreground" Value="#E0E0E4"/>
    <Setter Property="BorderBrush" Value="#3A3B42"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="MinHeight" Value="30"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="#202125"/>
    <Setter Property="Foreground" Value="#E0E0E4"/>
    <Setter Property="BorderBrush" Value="#3A3B42"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="#B9BAC2"/>
  </Style>
  <Style Selector="Slider">
    <Setter Property="Foreground" Value="{DynamicResource LadsAccent}"/>
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource LadsAccent}"/>
    <Setter Property="Background" Value="#303137"/>
  </Style>
  <Style Selector="ScrollViewer">
    <Setter Property="AllowAutoHide" Value="True"/>
  </Style>
  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="20,12"/>
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="Foreground" Value="#A0A1AA"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>

  <!-- ═══ 1.8.4 design system ═══════════════════════════════════════════════════════════════
       Segmented "pills" tabs: a rounded dark track; the chosen tab is a raised chip with a short accent bar.
       Use <TabControl Classes="pills"> for every sub-tab strip (Mods, Packs, Settings, modpack details, Servers). -->
  <Style Selector="TabControl.pills">
    <Setter Property="Padding" Value="0,14,0,0"/>
    <Setter Property="ItemsPanel">
      <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal" Spacing="4"/>
      </ItemsPanelTemplate>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate>
        <DockPanel>
          <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Background="#131417" BorderBrush="#2A2B31" BorderThickness="1" CornerRadius="10" Padding="4">
            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
          </Border>
          <ContentPresenter Name="PART_SelectedContentHost" Margin="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
        </DockPanel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.pills > TabItem">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#9EA0AA"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="18,0"/>
    <Setter Property="MinHeight" Value="38"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <Panel>
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            <Border Name="PART_PillBar" Height="2" Width="18" CornerRadius="1" Background="{DynamicResource LadsAccent}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" IsVisible="False"/>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="TabControl.pills > TabItem:pointerover">
    <Setter Property="Background" Value="#1E1F24"/>
    <Setter Property="Foreground" Value="#E6E7EB"/>
  </Style>
  <Style Selector="TabControl.pills > TabItem:selected">
    <Setter Property="Background" Value="#2A2B33"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="TabControl.pills > TabItem:selected /template/ Border#PART_PillBar">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="TabControl.pills > TabItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="BoxShadow" Value="0 1 4 0 #50000000"/>
  </Style>

  <!-- Page headers. -->
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="TextBlock.pageSubtitle">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="#8F919C"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <!-- Small accent heading inside a card ("VIDEO & MOUSE"). -->
  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="1.2"/>
    <Setter Property="Foreground" Value="{DynamicResource LadsAccent}"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="#8F919C"/>
  </Style>
  <!-- Cards: the one surface every page uses. Add "interactive" for hover feedback on clickable cards. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#1B1C20"/>
    <Setter Property="BorderBrush" Value="#2A2B31"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16"/>
  </Style>
  <Style Selector="Window.motion Border.card.interactive">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
        <BrushTransition Property="Background" Duration="0:0:0.15"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card.interactive:pointerover">
    <Setter Property="Background" Value="#202127"/>
    <Setter Property="BorderBrush" Value="#3C3D47"/>
  </Style>
  <Style Selector="Border.card.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}"/>
    <Setter Property="Background" Value="{DynamicResource LadsAccentSubtle}"/>
  </Style>
  <!-- Chips: small rounded labels (version, loader, category, "Online"). -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="#26272D"/>
    <Setter Property="CornerRadius" Value="999"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.chip > TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="#B5B7C0"/>
  </Style>
  <Style Selector="Border.chip.accent">
    <Setter Property="Background" Value="{DynamicResource LadsAccentSubtle}"/>
  </Style>
  <Style Selector="Border.chip.accent > TextBlock">
    <Setter Property="Foreground" Value="#F0A0A0"/>
  </Style>
  <Style Selector="Border.chip.good">
    <Setter Property="Background" Value="#1B2A20"/>
  </Style>
  <Style Selector="Border.chip.good > TextBlock">
    <Setter Property="Foreground" Value="#7FD99A"/>
  </Style>
  <!-- Square ghost button for an icon or glyph (copy, open folder, delete). -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#B5B7C0"/>
    <Setter Property="BorderBrush" Value="#34353B"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#2A2B31"/>
    <Setter Property="BorderBrush" Value="#4A4B55"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="Button.icon.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#443033"/>
    <Setter Property="Foreground" Value="#FFBBBB"/>
  </Style>
  <!-- ═══ end design system ═══ -->
  <Style Selector="Button.nav.active:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}"/>
  </Style>
  <!-- Title-bar logo: zooms in on hover. -->
  <Style Selector="Image.titleLogo">
    <Setter Property="RenderTransform" Value="scale(1)"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Image.titleLogo:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.15)"/>
  </Style>
  <!-- Play-screen pickers: the chosen entry gets an accent bar and bold text; versions not offered are greyed out. -->
  <Style Selector="ComboBox.launchPicker ComboBoxItem">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="BorderThickness" Value="4,0,0,0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="ComboBox.launchPicker ComboBoxItem:selected">
    <Setter Property="BorderBrush" Value="{DynamicResource LadsAccent}"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>
  <Style Selector="ComboBox.launchPicker ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource LadsAccentSubtle}"/>
    <Setter Property="Foreground" Value="White"/>
  </Style>
  <Style Selector="ComboBox.launchPicker ComboBoxItem:disabled">
    <Setter Property="Opacity" Value="0.4"/>
  </Style>
</Styles>
