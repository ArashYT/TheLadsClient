<Window xmlns="https://github.com/avaloniaui" xmlns:local="using:TheLadsLauncher.Controls" xmlns:views="using:TheLadsLauncher.Views" xmlns:models="using:TheLadsLauncher.Models" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="TheLadsLauncher.MainWindow" Title="The Lads Client" Width="1152" Height="720" MinWidth="960" MinHeight="600" Background="#17181B" Icon="avares://TheLadsLauncher/Assets/icon.ico" WindowStartupLocation="CenterScreen" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="44" WindowDecorations="BorderOnly">
    <Window.Resources>
        <DataTemplate x:Key="ModListItemTemplate">
            <Border Classes="modcard" Background="#1D1E22" CornerRadius="4" Padding="16,12" BorderBrush="#303137" BorderThickness="1" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Name="ModIconFrame" Width="44" Height="44" CornerRadius="4" ClipToBounds="True" Background="#25262A" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Image Name="ModIcon" Width="44" Height="44" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Name="ModTitle" Classes="notranslate" Foreground="White" FontSize="14" FontWeight="Bold" />
                        <TextBlock Name="ModDescription" Foreground="#A0A1AA" FontSize="12" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBlock Name="Downloads" Classes="notranslate" Foreground="#868994" FontSize="10" />
                            <StackPanel Name="ModBadges" Orientation="Horizontal" Spacing="4" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Name="ActionPanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">

                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <LayoutTransformControl x:Name="UiScaleTransformControl">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="1" ScaleY="1" />
        </LayoutTransformControl.LayoutTransform>
        <Grid x:Name="RootGrid">
            <Grid RowDefinitions="44,*" ColumnDefinitions="184,*">
                <Border x:Name="TitleBar" Background="#121315" BorderBrush="#303137" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Margin="19,0,0,0" Spacing="9" VerticalAlignment="Center">
                        <Image Classes="titleLogo" Source="avares://TheLadsLauncher/Assets/logo.png" Width="146" Height="30" Stretch="Uniform" />
                    </StackPanel>
                </Border>
                <Border x:Name="ContentTitleBar" Grid.Column="1" Background="#17181B" BorderBrush="#303137" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0" VerticalAlignment="Center">
                            <TextBlock Text="THE LADS CLIENT  /  LAUNCHER" Classes="caption" VerticalAlignment="Center" FontSize="9" />
                            <Path x:Name="SeasonalBadge" IsVisible="False" ToolTip.Tip="Happy Halloween" Data="M 9,5 C 3,5 1,8.5 1,11.5 C 1,15 4,17 9,17 C 14,17 17,15 17,11.5 C 17,8.5 15,5 9,5 Z M 9,5 C 6.5,8 6.5,14 9,17 C 11.5,14 11.5,8 9,5 M 9,5 C 9,3 9.5,2 11,1" Width="15" Height="15" Stretch="Uniform" Stroke="#F28A2E" StrokeThickness="1.4" StrokeLineCap="Round" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Shown when a verified update is ready while the launcher is open: glow behind, glossy pill, shine sweep on top. -->
                            <Grid x:Name="UpdateNowHost" IsVisible="False" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Border x:Name="UpdateNowGlow" CornerRadius="15" Background="#E0525B" BoxShadow="0 0 18 3 #E0525B" Opacity="0.6" IsHitTestVisible="False" />
                                <Button x:Name="UpdateNowBtn" Classes="updateNow" Content="&#8679;  Update" Click="UpdateNow_Click" />
                                <Border CornerRadius="15" ClipToBounds="True" IsHitTestVisible="False">
                                    <Border x:Name="UpdateNowShine" Width="18" HorizontalAlignment="Left">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="#B3FFFFFF" Offset="0.5" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform AngleX="-22" />
                                                <TranslateTransform X="-40" />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                            <Button x:Name="AspectLockBtn" Classes="window" Content="Aspect Ratio: Free" ToolTip.Tip="Toggle 16:9 aspect lock" Click="AspectLockBtn_Click" />
                            <Button x:Name="ResetSizeBtn" Classes="window" Content="Reset Size" ToolTip.Tip="Reset window size" Click="ResetSizeBtn_Click" />
                            <Button x:Name="CheckUpdateBtn" Classes="window" ToolTip.Tip="Check for launcher updates" Click="CheckUpdateBtn_Click" Padding="7,0">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Path Data="M 12,4 V 1 M 12,4 A 8,8 0 1 1 5,7 L 3,5" Width="11" Height="11" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.4" StrokeLineCap="Round" VerticalAlignment="Center" />
                                    <TextBlock Text="Update" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="MinimizeBtn" Classes="window" Content="&#9472;" ToolTip.Tip="Minimize" Click="MinimizeBtn_Click" />
                            <Button x:Name="MaximizeBtn" Classes="window" Content="&#9633;" ToolTip.Tip="Maximize" Click="MaximizeBtn_Click" />
                            <Button x:Name="CloseBtn" Classes="window close" Content="&#215;" ToolTip.Tip="Close" Click="CloseBtn_Click" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border x:Name="Sidebar" Grid.Row="1" Background="#121315" BorderBrush="#303137" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer>
                            <StackPanel Spacing="3" Margin="10,20,10,0">
                                <Button x:Name="NavHome" AutomationProperties.Name="Play" Classes="nav active" Click="NavHome_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 3,2 L 15,9 3,16 Z" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Play" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavAccounts" AutomationProperties.Name="Accounts" Classes="nav" Click="NavAccounts_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 9,2 A 3,3 0 1 1 8.99,2 M 2,17 V 14 C 2,9 16,9 16,14 V 17" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Accounts" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavSkins" AutomationProperties.Name="Skins" Classes="nav" Click="NavSkins_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 6,2 L 2,5 4,8 6,7 V 16 H 12 V 7 L 14,8 16,5 12,2 C 11,4 7,4 6,2 Z" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" StrokeJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Skins" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavProfiles" AutomationProperties.Name="Profiles" Classes="nav" Click="NavProfiles_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 2,3 H 16 V 13 H 2 Z M 6,16 H 12 M 9,13 V 16" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Profiles" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavModpacks" AutomationProperties.Name="Modpacks" Classes="nav" Click="NavModpacks_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 9,1 L 16,5 V 13 L 9,17 L 2,13 V 5 Z M 2,5 L 9,9 L 16,5 M 9,9 V 17" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" StrokeJoin="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Modpacks" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="#28292E" Margin="12,12" />
                                <Button x:Name="NavWorlds" AutomationProperties.Name="Worlds" Classes="nav" Click="NavWorlds_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 9,1 A 8,8 0 1 1 8.99,1 Z M 1,9 H 17 M 9,1 C 5,4 5,14 9,17 M 9,1 C 13,4 13,14 9,17" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Worlds" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavServers" AutomationProperties.Name="Servers" Classes="nav" Click="NavServers_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 2,2 H 16 V 7 H 2 Z M 2,11 H 16 V 16 H 2 Z M 5,4.5 H 6 M 5,13.5 H 6" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Servers" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavMods" AutomationProperties.Name="Mods" Classes="nav" Click="NavMods_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 2,2 H 7 V 7 H 2 Z M 11,2 H 16 V 7 H 11 Z M 2,11 H 7 V 16 H 2 Z M 11,11 H 16 V 16 H 11 Z" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Mods" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavPacks" AutomationProperties.Name="Packs" Classes="nav" Click="NavPacks_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 2,7 L 9,3 L 16,7 L 9,11 Z M 2,10.5 L 9,14.5 L 16,10.5" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" StrokeLineCap="Round" VerticalAlignment="Center" />
                                        <TextBlock Text="Packs" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavGallery" AutomationProperties.Name="Gallery" Classes="nav" Click="NavGallery_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 2,2 H 16 V 16 H 2 Z M 2,13 L 7,8 11,12 13,10 16,13 M 12,5 H 13" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Gallery" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavFiles" AutomationProperties.Name="Files" Classes="nav" Click="NavFiles_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 1,5 V 3 H 7 L 9,5 H 17 V 15 H 1 Z" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Files" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Border Height="1" Background="#28292E" Margin="12,12" />
                                <Button x:Name="NavSettings" AutomationProperties.Name="Settings" Classes="nav" Click="NavSettings_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 2,4 H 16 M 2,9 H 16 M 2,14 H 16 M 6,2 V 6 M 12,7 V 11 M 6,12 V 16" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Settings" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NavLogs" AutomationProperties.Name="Logs" Classes="nav" Click="NavLogs_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="13">
                                        <Path Data="M 2,3 L 6,7 2,11 M 9,12 H 16" Width="17" Height="17" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.3" VerticalAlignment="Center" />
                                        <TextBlock Text="Logs" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" BorderBrush="#303137" BorderThickness="0,1,0,0" Padding="18,18">
                            <StackPanel Spacing="13">
                                <Grid ColumnDefinitions="Auto,*">
                                    <Ellipse x:Name="MiniSkinHead" Width="26" Height="26" Fill="#303137" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                        <TextBlock x:Name="MiniAccountName" Classes="notranslate" Text="No account" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="PLAYER ACCOUNT" Classes="caption" FontSize="8" LetterSpacing="0.7" />
                                    </StackPanel>
                                </Grid>
                                <Button Content="Release notes" Click="ReleaseNotes_Click" Background="Transparent" FontSize="11" />
                                <TextBlock x:Name="VersionText" Foreground="#767984" FontSize="10" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="*,Auto">
                    <Grid x:Name="HomePage" Margin="28,16,28,16" RowDefinitions="Auto,Auto,Auto,Auto">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <TextBlock Text="Play" FontSize="24" FontWeight="SemiBold" />
                            <Border x:Name="MinecraftVersionPill" Grid.Column="1" VerticalAlignment="Center" BorderBrush="#3A3B42" BorderThickness="1" Padding="10,4" CornerRadius="3">
                                <TextBlock x:Name="MinecraftVersionText" Text="Minecraft" Foreground="#B8B9C2" FontSize="11" />
                            </Border>
                        </Grid>
                        <Border Grid.Row="1" Background="#1D1E22" BorderBrush="#34353B" BorderThickness="1" CornerRadius="5" ClipToBounds="True" Height="140">
                            <!-- The art column is twice the banner height: the 2:1 artwork shows whole instead of being cropped to a strip. -->
                            <Grid ColumnDefinitions="*,280">
                                <StackPanel Margin="24,8,0,8" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Border Width="14" Height="2" Background="{DynamicResource LadsAccent}" VerticalAlignment="Center" />
                                        <TextBlock Text="BUILT FOR YOUR GAME" Classes="caption" FontSize="9" />
                                    </StackPanel>
                                    <TextBlock Text="THE LADS CLIENT." FontFamily="Bahnschrift SemiCondensed,Inter" FontSize="30" FontWeight="Bold" LetterSpacing="-0.5" />
                                    <TextBlock Text="Your worlds. Your mods. Your people." Foreground="#999BA5" FontSize="13" />
                                </StackPanel>
                                <!-- The Lads artwork fills the right column and fades into the card behind the title. -->
                                <Border Grid.Column="1" IsHitTestVisible="False">
                                    <Border.Background>
                                        <ImageBrush Source="avares://TheLadsLauncher/Assets/artwork.jpg" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Border Grid.Column="1" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Color="#FF1D1E22" Offset="0" />
                                            <GradientStop Color="#001D1E22" Offset="0.42" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Canvas x:Name="ParticleCanvas" Grid.ColumnSpan="2" IsHitTestVisible="False" Opacity="0.10" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" Margin="0,10,0,8">
                            <Button Classes="shortcut" Click="NavProfiles_Click" Margin="0,0,18,0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Data="M 2,7 L 10,2 L 18,7 L 10,12 Z M 2,11 L 10,16 L 18,11 M 2,15 L 10,20 L 18,15" Width="17" Height="17" Stretch="Uniform" Stroke="#E0525E" StrokeThickness="1.5" StrokeLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Version profiles" FontWeight="Medium" />
                                        <TextBlock Text="Switch up your setup" FontSize="11" Foreground="#8F919B" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#8599;" Foreground="#8F919B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Classes="shortcut" Click="NavMods_Click" Margin="0,0,18,0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Data="M 4,4 H 8 A 2,2 0 0 1 12,4 H 16 V 8 A 2,2 0 0 1 16,12 V 16 H 12 A 2,2 0 0 0 8,16 H 4 V 12 A 2,2 0 0 0 4,8 Z" Width="17" Height="17" Stretch="Uniform" Stroke="#52A5E0" StrokeThickness="1.5" StrokeLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Mods" FontWeight="Medium" />
                                        <TextBlock Text="Find your next addition" FontSize="11" Foreground="#8F919B" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#8599;" Foreground="#8F919B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button Grid.Column="2" Classes="shortcut" Click="NavGallery_Click">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Path Data="M 3,6 H 6 L 8,3 H 12 L 14,6 H 17 A 2,2 0 0 1 19,8 V 17 A 2,2 0 0 1 17,19 H 3 A 2,2 0 0 1 1,17 V 8 A 2,2 0 0 1 3,6 Z M 10,15 A 3.5,3.5 0 1 0 10,8 A 3.5,3.5 0 1 0 10,15 Z" Width="17" Height="17" Stretch="Uniform" Stroke="#50C878" StrokeThickness="1.5" StrokeLineCap="Round" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Screenshots" FontWeight="Medium" />
                                        <TextBlock Text="The moments you kept" FontSize="11" Foreground="#8F919B" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="&#8599;" Foreground="#8F919B" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </Grid>
                        <Border Grid.Row="3" BorderBrush="#303137" BorderThickness="0,1,0,1" Padding="0,16,0,14">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,*,220">
                                <TextBlock Text="PROFILE" Classes="caption" Margin="0,0,0,7" />
                                <TextBlock Grid.Column="1" Text="PLAYING AS" Classes="caption" Margin="0,0,0,7" />
                                <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,*,220">
                                    <ComboBox x:Name="LaunchProfileSelector" Classes="launchPicker notranslate" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" ToolTip.Tip="Choose the Minecraft profile to launch" SelectionChanged="LaunchProfileSelector_SelectionChanged" Height="69" HorizontalAlignment="Stretch" Grid.Column="0" Margin="0,0,12,0" />
                                    <ComboBox x:Name="LaunchAccountSelector" Classes="launchPicker" PlaceholderText="Select an account" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" ToolTip.Tip="Launch with this account (does not change your main account)" SelectionChanged="LaunchAccountSelector_SelectionChanged" Height="69" HorizontalAlignment="Stretch" Grid.Column="1" Margin="0,0,16,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:AccountChoice">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <Border Width="32" Height="32" CornerRadius="4" ClipToBounds="True" Background="#303137">
                                                        <Image Source="{Binding Head}" Width="32" Height="32" RenderOptions.BitmapInterpolationMode="None" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Label}" Classes="notranslate" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <Button x:Name="LaunchButton" Classes="launch" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Right-click to launch with a different account" Click="LaunchButton_Click" Height="69" Grid.Column="2" MinWidth="220" Margin="0">
                                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Data="M 4,2 L 16,10 L 4,18 Z" Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                                            <TextBlock Text="Play" FontWeight="Bold" FontSize="22" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu x:Name="LaunchContextMenu">
                                                <MenuItem Header="Launch with account:" IsEnabled="False" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </Grid>
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="0,10,0,0" Spacing="5">
                                    <TextBlock x:Name="StatusText" Text="Ready to play" Foreground="#9C9EA8" FontSize="11" TextWrapping="Wrap" />
                                    <ProgressBar x:Name="ProgressBar" Height="2" Minimum="0" Maximum="100" Value="0" />
                                </StackPanel>
                                <Border x:Name="HomeSharedNotice" Grid.Row="3" Grid.ColumnSpan="3" IsVisible="False" Margin="0,10,0,0" Background="#202125" BorderBrush="#3A3B42" BorderThickness="1" CornerRadius="4" Padding="12,8" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:Name="AccountsPage" IsVisible="False" Margin="28,24,28,24">
                        <Border Grid.Column="0" Background="#1D1E22" CornerRadius="4" Padding="16" BorderBrush="#303137" BorderThickness="1" Margin="0,0,12,0">
                            <Grid RowDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Row="0" Spacing="7" Margin="0,0,0,14">
                                    <TextBlock Text="Your accounts" Foreground="White" FontSize="20" FontWeight="Bold" />
                                    <TextBlock Text="Choose a default account for this launcher." Foreground="#9AA7B8" FontSize="12" TextWrapping="Wrap" />
                                    <Border Background="#141F29" CornerRadius="4" Padding="10">
                                        <TextBlock x:Name="AccountsSignInStatus" Foreground="#BAD3DE" FontSize="11" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1">
                                    <StackPanel x:Name="AccountsListContainer" Spacing="6" />
                                </ScrollViewer>
                                <StackPanel Grid.Row="2" Spacing="8" Margin="0,12,0,0">
                                    <Button x:Name="AddMicrosoftAccountBtn" Classes="launch" Content="Add Microsoft account" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="38" Foreground="White" FontWeight="Bold" Click="AddMicrosoftAccount_Click" />
                                    <Button x:Name="AddOfflineAccountBtn" Classes="action" Content="Add local development account" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34" Click="AddOfflineAccount_Click" />
                                    <TextBlock Text="Local accounts support offline development and singleplayer." Foreground="#7E8B9D" FontSize="10" TextWrapping="Wrap" />
                                    <Grid ColumnDefinitions="*" RowDefinitions="Auto,Auto">
                                        <Button x:Name="RemoveAccountBtn" Classes="action" Content="Remove Account" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34" Margin="0,4,0,0" Click="RemoveAccount_Click" Grid.Row="0" />
                                        <Button x:Name="ClearCacheBtn" Classes="danger" Content="Sign out Microsoft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Height="34" Margin="0,4,0,0" Click="ClearCache_Click" Grid.Row="1" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <views:WorldsView x:Name="WorldsPage" IsVisible="False" />
                    <views:ServersView x:Name="ServersPage" IsVisible="False" />
                    <views:ModpacksView x:Name="ModpacksPage" IsVisible="False" />
                    <views:SkinsView x:Name="SkinsPage" IsVisible="False" />
                    <Grid x:Name="ProfilesPage" IsVisible="False" Margin="28,24,28,24" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*" Margin="0,0,0,16" RowDefinitions="Auto,Auto,Auto">
                            <StackPanel>
                                <TextBlock Text="Profiles" Foreground="White" FontSize="22" FontWeight="Bold" />
                                <TextBlock Text="Separate versions and mod collections. Worlds, resource packs, shader packs and servers are always shared from the global .minecraft folder; isolating a profile keeps only its game settings (options.txt, keybinds) separate." Foreground="#A0A1AA" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8" Grid.Row="1" Margin="0,16,0,0">
                                <Button x:Name="SyncSharedBtn" Classes="action" Content="Sync settings &amp; shared folders" ToolTip.Tip="Syncs game settings (unless the profile is isolated) and links worlds, resource packs, shader packs and the server list to the global .minecraft folder" Height="36" Padding="12,0" Click="SyncSharedSettings_Click" />
                                <Button x:Name="AddProfileBtn" Classes="launch" Content="New Profile" Height="36" Padding="14,0" Foreground="White" FontWeight="Bold" Click="AddProfile_Click" />
                                <TextBlock x:Name="ProfilesStatusText" Foreground="#A0A1AA" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="8,0,0,0" />
                            </StackPanel>
                            <Border x:Name="ProfilesSharedNotice" Grid.Row="2" IsVisible="False" Margin="0,12,0,0" Background="#202125" BorderBrush="#3A3B42" BorderThickness="1" CornerRadius="4" Padding="14,10" />
                        </Grid>
                        <Grid Grid.Row="1" RowDefinitions="Auto,*">
                            <Grid ColumnDefinitions="*,150,Auto" Margin="0,0,0,12">
                                <TextBox x:Name="ProfileSearch" PlaceholderText="Search profiles…" Margin="0,0,8,0" />
                                <ComboBox x:Name="ProfileVersionFilter" Grid.Column="1" HorizontalAlignment="Stretch" />
                                <Button Grid.Column="2" Content="Import settings…" Classes="action" Margin="8,0,0,0" Click="ImportProfilePreset_Click" />
                            </Grid>
                            <ScrollViewer Grid.Row="1">
                                <StackPanel x:Name="ProfilesListContainer" Spacing="10" />
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                    <Grid x:Name="SettingsPage" IsVisible="False" Margin="28,24,28,24" RowDefinitions="Auto,*,Auto">
                        <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <TabControl Grid.Row="1">
                            <TabItem Header="General">
                                <ScrollViewer Margin="0,16,0,16">
                                    <StackPanel Spacing="16">
                                        <Border Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="APPEARANCE" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="Theme" Foreground="#CCCCCC" FontSize="14" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="ThemeSelector" Grid.Column="1" Width="160" Height="36" FontSize="13" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                    <TextBlock Text="UI Scale" Foreground="#CCCCCC" FontSize="14" VerticalAlignment="Center" />
                                                    <ComboBox x:Name="UiScaleSelector" Grid.Column="1" Width="160" Height="36" FontSize="13" />
                                                </Grid>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                                    <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock Text="Language" Foreground="#CCCCCC" FontSize="14" />
                                                        <TextBlock Text="Translated automatically by Google Translate. Names, servers, worlds and files are never sent." Foreground="#868994" FontSize="11" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <!-- Native names, never translated; LauncherTranslator does the rest of the launcher. -->
                                                    <ComboBox x:Name="LanguageSelector" Classes="notranslate" Grid.Column="1" Width="200" Height="36" FontSize="13" VerticalAlignment="Center" />
                                                </Grid>
                                                <CheckBox x:Name="ReducedMotionCheck" Content="Reduce motion (page, button and notification animations)" Margin="0,0,0,8" />
                                    <CheckBox x:Name="ParticleCheckbox" Content="Show background particles" IsChecked="True" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="BEHAVIOR" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                                                <Grid ColumnDefinitions="*,24,*">
                                                    <StackPanel Spacing="12">
                                                        <CheckBox x:Name="CloseToTrayCheckbox" Content="Minimize to system tray when game is running" IsChecked="True" />
                                                        <CheckBox x:Name="KeepLauncherOpenCheckbox" Content="Keep launcher open after launching the game" IsChecked="False" />
                                                        <CheckBox x:Name="KeepClosedOnExitCheckbox" Content="Don't re-open the launcher when the game closes" IsChecked="False" />
                                                        <CheckBox x:Name="DiscordPresenceCheckbox" Content="Show what I'm doing on Discord (Rich Presence)" IsChecked="True" />
                                                        <CheckBox x:Name="AutoLaunchCheckbox" Content="Auto-launch game when launcher opens" IsChecked="False" />
                                                        <CheckBox x:Name="MultiInstanceCheckbox" Content="Allow launching multiple copies of the same instance" IsChecked="False" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Spacing="12">
                                                        <CheckBox x:Name="AutoFixCrashesCheckbox" Content="Auto-Fix issues on crash (Disables broken mods)" IsChecked="True" />
                                                        <CheckBox x:Name="AutoRelaunchOnCrashCheckbox" Content="Auto-relaunch game on crash" IsChecked="False" />
                                                        <CheckBox x:Name="AutoRejoinServerCheckbox" Content="Auto-rejoin server on launch" IsChecked="False" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="28,0,0,0">
                                                            <TextBlock Text="Server:" Foreground="#A0A1AA" FontSize="12" VerticalAlignment="Center" />
                                                            <ComboBox x:Name="QuickLaunchServerComboBox" Classes="notranslate" Width="240" Height="28" FontSize="12" ToolTip.Tip="Pick a server from the shared Minecraft server list, or use Auto to detect from game logs" />
                                                            <Button x:Name="RefreshServerListBtn" Content="&#8635;" Width="28" Height="28" Padding="0" FontSize="14" HorizontalContentAlignment="Center" ToolTip.Tip="Reload the shared server list (servers.dat in the global .minecraft folder)" Click="RefreshServerList_Click" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock Text="GRAPHICS" Foreground="{DynamicResource LadsAccent}" FontWeight="Bold" Margin="0,8,0,0" />
                                                <ComboBox x:Name="GraphicsRendererSelector" HorizontalAlignment="Stretch" SelectedIndex="0">
                                                    <ComboBoxItem Content="Vulkan — primary (26.2+)" />
                                                    <ComboBoxItem Content="OpenGL — compatibility and Iris shaders" />
                                                </ComboBox>
                                                <TextBlock Text="Applies on next launch. Vulkan uses OpenGL if unavailable; Iris shader mods stay off in Vulkan mode. Older Minecraft versions use OpenGL." TextWrapping="Wrap" Foreground="#A0A1AA" FontSize="12" />
                                                <CheckBox x:Name="FullscreenOnLaunchCheckbox" Content="Launch game in fullscreen" IsChecked="True" />
                                                <CheckBox x:Name="QuickLaunchCheckbox" Content="Quick Launch &#8212; skip file verification (faster, disable if game is broken)" IsChecked="False" />
                                                <CheckBox x:Name="SyncScreenshotsCheckbox" Content="Sync screenshots to global .minecraft folder on game close" IsChecked="True" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Memory &amp; Java">
                                <ScrollViewer Margin="0,16,0,16">
                                    <StackPanel Spacing="16">
                                        <Border Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="MEMORY" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="Maximum RAM Allocation" Foreground="#CCCCCC" FontSize="14" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="RamValueText" Grid.Column="1" Text="4 GB" Foreground="White" FontSize="14" FontWeight="Bold" />
                                                    </Grid>
                                                    <Slider x:Name="RamSlider" Minimum="1" Maximum="32" Value="4" TickFrequency="1" IsSnapToTickEnabled="True" />
                                                    <TextBlock x:Name="RamRecommendText" Text="Recommended: 4-8 GB for modded Minecraft" Foreground="#868994" FontSize="11" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="JAVA RUNTIME" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                                                    <TextBlock Text="Java Installation" Foreground="#CCCCCC" FontSize="14" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" x:Name="DownloadJavaBtn" Classes="action" Content="&#9889; Download Adoptium JDK" Height="32" Margin="0,0,8,0" Padding="12,0" FontSize="12" HorizontalContentAlignment="Center" Click="DownloadJava_Click" />
                                                    <Button Grid.Column="2" Classes="action" Content="Detect" Height="32" Width="80" FontSize="12" HorizontalContentAlignment="Center" Click="DetectJava_Click" />
                                                </Grid>
                                                <ComboBox x:Name="JavaSelector" Classes="notranslate" HorizontalAlignment="Stretch" Height="36" FontSize="12" />
                                                <ProgressBar x:Name="JavaDownloadProgress" Minimum="0" Maximum="100" Value="0" Height="6" IsVisible="False" Foreground="{DynamicResource LadsAccent}" HorizontalAlignment="Stretch" />
                                                <TextBlock x:Name="JavaStatusText" Text="" Foreground="#A0A1AA" FontSize="11" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Paths &amp; services">
                                <ScrollViewer Margin="0,16,0,16">
                                    <StackPanel Spacing="16">
                                        <Border Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="PATHS" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Instance Directory" Foreground="#A0A1AA" FontSize="12" />
                                                    <TextBox x:Name="InstancePathBox" IsReadOnly="True" Height="32" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Packwiz Source" Foreground="#A0A1AA" FontSize="12" />
                                                    <TextBox x:Name="PackwizPathBox" IsReadOnly="True" Height="32" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Fabric Loader Version" Foreground="#A0A1AA" FontSize="12" />
                                                    <TextBox x:Name="FabricVersionBox" MinHeight="32" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="CurseForge API Key" Foreground="#A0A1AA" FontSize="12" />
                                                    <TextBox x:Name="CurseForgeApiKeyBox" Height="32" FontSize="12" PasswordChar="*" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Modrinth API URL" Foreground="#A0A1AA" FontSize="12" />
                                                    <TextBox x:Name="ModrinthApiUrlBox" MinHeight="32" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="CurseForge API URL" Foreground="#A0A1AA" FontSize="12" />
                                                    <TextBox x:Name="CurseForgeApiUrlBox" MinHeight="32" FontSize="12" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Minecraft Version Override" Foreground="#A0A1AA" FontSize="12" />
                                                    <TextBox x:Name="MinecraftVersionOverrideBox" Height="32" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Controls">
                                <views:ControlsSettingsView x:Name="ControlsSettings" Margin="0,16,0,16" />
                            </TabItem>
                            <TabItem Header="Microsoft sign-in">
                                <ScrollViewer Margin="0,16,0,16">
                                    <StackPanel Spacing="16">
                                        <Border Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="MICROSOFT SIGN-IN" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="Microsoft application (client) ID" Foreground="#CCCCCC" />
                                                <TextBox x:Name="MicrosoftClientIdTextBox" PlaceholderText="Application ID registered for The Lads Client" />
                                                <TextBlock Text="The Lads Client's registered application ID is included. Leave blank to restore it, or enter your own desktop application ID." Foreground="#999999" TextWrapping="Wrap" />
                                                <TextBlock Text="Minecraft Services approval is required separately. No client secret is needed." Foreground="#CCCCCC" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                        <TextBlock x:Name="SettingsSaveStatus" Grid.Row="2" VerticalAlignment="Center" Foreground="#A4BAA7" FontSize="12" Text="Changes save automatically" />
                    </Grid>
                    <Grid x:Name="ModsPage" IsVisible="False" Margin="28,24,28,24" DragDrop.AllowDrop="True" RowDefinitions="*,Auto">
                        <TabControl x:Name="ModsSubTabControl">
                            <TabControl.Styles>
                                <Style Selector="TabItem">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="#A0A1AA" />
                                    <Setter Property="Padding" Value="16,10" />
                                    <Setter Property="Cursor" Value="Hand" />
                                </Style>
                                <Style Selector="TabItem:pointerover">
                                    <Setter Property="Foreground" Value="#CCCCCC" />
                                </Style>
                                <Style Selector="TabItem:selected">
                                    <Setter Property="Foreground" Value="White" />
                                </Style>
                            </TabControl.Styles>
                            <TabItem x:Name="ModsInstalledTab" Header="Installed Mods">
                                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="0,12,0,0">
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,10">
                                        <CheckBox x:Name="SelectAllModsCheckbox" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip.Tip="Select / deselect every row shown (hidden rows are never selected)" Click="SelectAllMods_Click" />
                                        <TextBlock Grid.Column="1" Text="Installed Mods" Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" x:Name="ModsPageCount" Text="" Foreground="#868994" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="Jars in this profile's Mods folder · pack mods waiting to be downloaded · pack mods shipped only for other Minecraft versions" />
                                    </Grid>
                                    <WrapPanel Grid.Row="1" Margin="0,0,0,2">
                                        <TextBox x:Name="ModNameSearchBox" Height="36" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,8,8" PlaceholderText="Search name, mod id or file&#8230;" TextChanged="ModNameSearch_TextChanged" Width="210" />
                                        <ComboBox x:Name="ModsFilterBox" Width="200" Height="36" SelectedIndex="0" Margin="0,0,8,8" SelectionChanged="ModsFilter_Changed" ToolTip.Tip="Show one kind of entry">
                                            <ComboBoxItem>All</ComboBoxItem>
                                            <ComboBoxItem>Lads modules</ComboBoxItem>
                                            <ComboBoxItem>Third-party</ComboBoxItem>
                                            <ComboBoxItem>Enabled</ComboBoxItem>
                                            <ComboBoxItem>Disabled</ComboBoxItem>
                                            <ComboBoxItem>Libraries &amp; dependencies</ComboBoxItem>
                                        </ComboBox>
                                        <Button Classes="action" Content="Reset filters" Height="36" FontSize="13" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,16,8" ToolTip.Tip="Show the whole inventory (All, no search)" Click="ResetModFilters_Click" />
                                        <Button x:Name="AddModBtn" Classes="action" Content="Add &#9662;" Height="36" FontSize="13" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,8,8" ToolTip.Tip="Add a mod from a .jar file or a folder of jars (existing files are never overwritten)">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuItem Header="Add from file&#8230;" Click="AddModFromFile_Click" />
                                                    <MenuItem Header="Add from folder&#8230;" Click="AddModFromFolder_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button x:Name="UpdateAllModsBtn" Classes="action" Content="Update my mods" Height="36" FontSize="13" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,8,8" ToolTip.Tip="Update the mods you added yourself from Modrinth; the launcher keeps the pack mods and LadsCore up to date" Click="UpdateAllMods_Click" />
                                        <Button Classes="danger" Content="Restore default mod set" Height="36" FontSize="13" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,8,8" ToolTip.Tip="Clear this profile's saved enable/disable choices and switch the pack mods and LadsCore back on" Click="RestoreDefaultMods_Click" />
                                        <Button Classes="danger" Content="Reset mods folder" Height="36" FontSize="13" Padding="12,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,8,8" ToolTip.Tip="Move every mod file of this profile to the Recycle Bin (yours too), clear its saved enable/disable choices and reinstall LadsCore and the Lads pack fresh" Click="ResetModsFolder_Click" />
                                        <Button Classes="action" Content="Refresh" Height="36" FontSize="13" Padding="14,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="RefreshMods_Click" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <Border Grid.Row="2" x:Name="ModsMassActionBar" IsVisible="False" Background="#202125" CornerRadius="4" Padding="12,7" Margin="0,0,0,8" BorderBrush="#3A3B42" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock x:Name="ModsSelectionCount" Text="0 selected" Foreground="#A0A1AA" FontSize="13" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <Button Classes="action" Content="Enable" Height="30" FontSize="12" Padding="10,0" HorizontalContentAlignment="Center" Click="EnableSelectedMods_Click" />
                                            <Button Classes="danger" Content="Disable" Height="30" FontSize="12" Padding="10,0" HorizontalContentAlignment="Center" Click="DisableSelectedMods_Click" />
                                            <Button Classes="danger" Content="Delete" Height="30" FontSize="12" Padding="10,0" HorizontalContentAlignment="Center" ToolTip.Tip="Only mods you added yourself (to the Recycle Bin)" Click="DeleteSelectedMods_Click" />
                                            <Button Classes="action" Content="Update" Height="30" FontSize="12" Padding="10,0" HorizontalContentAlignment="Center" ToolTip.Tip="Only mods you added yourself" Click="UpdateSelectedMods_Click" />
                                        </StackPanel>
                                    </Border>
                                    <ScrollViewer Grid.Row="3" SizeChanged="ModsListScroller_SizeChanged">
                                        <WrapPanel x:Name="ModsList" ItemWidth="440" />
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ModsBrowseTab" Header="Browse Mods">
                                <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
                                        <TextBox x:Name="ModSearchBox" PlaceholderText="Search mods (e.g. Sodium, Iris) &#8212; searches as you type" Height="36" FontSize="13" Margin="0,0,8,0" TextChanged="ModSearchBox_TextChanged" />
                                        <ComboBox x:Name="ModSearchProvider" Grid.Column="1" Width="130" Height="36" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="BrowseFilter_Changed">
                                            <ComboBoxItem Content="Modrinth" />
                                            <ComboBoxItem Content="CurseForge" />
                                        </ComboBox>
                                        <ComboBox x:Name="SearchModMcVersionDropdown" Grid.Column="2" Width="130" Height="36" Margin="0,0,8,0" SelectionChanged="BrowseFilter_Changed" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1">
                                        <StackPanel x:Name="BrowseModsList" Spacing="6" />
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="PacksBrowseTab" Header="Resource Packs" IsVisible="False">
                                <Grid RowDefinitions="Auto,Auto,*" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                                        <Button Classes="action" Content="Open resource packs folder" Tag="resourcepacks" Height="34" Padding="12,0" HorizontalContentAlignment="Center" ToolTip.Tip="The shared resource packs folder (every version)" Click="OpenSharedFolder_Click" />
                                        <Button Classes="action" Content="Open shader packs folder" Tag="shaderpacks" Height="34" Padding="12,0" HorizontalContentAlignment="Center" ToolTip.Tip="The shared shader packs folder (every version)" Click="OpenSharedFolder_Click" />
                                        <Button x:Name="UpdateResourcePacksBtn" Classes="launch" Content="Update resource packs" Height="34" Padding="12,0" HorizontalContentAlignment="Center" ToolTip.Tip="Replace the packs in the shared folder with their newest release for the Minecraft version chosen below (Modrinth, and CurseForge when a key is set); enabled packs stay enabled" Click="UpdateResourcePacks_Click" />
                                    </StackPanel>
                                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,16">
                                        <TextBox x:Name="RpSearchBox" PlaceholderText="Search resource packs &#8212; searches as you type" Height="36" FontSize="13" Margin="0,0,8,0" TextChanged="RpSearchBox_TextChanged" />
                                        <ComboBox x:Name="RpSearchProvider" Grid.Column="1" Width="130" Height="36" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="BrowseFilter_Changed">
                                            <ComboBoxItem Content="Modrinth" />
                                            <ComboBoxItem Content="CurseForge" />
                                        </ComboBox>
                                        <ComboBox x:Name="SearchRpMcVersionDropdown" Grid.Column="2" Width="130" Height="36" Margin="0,0,8,0" SelectionChanged="BrowseFilter_Changed" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="2">
                                        <StackPanel x:Name="BrowseRpList" Spacing="6" />
                                    </ScrollViewer>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ShaderPacksTab" Header="Shader Packs" IsVisible="False">
                                <views:PackBrowserView x:Name="ShaderPacksView" Kind="Shader" />
                            </TabItem>
                            <TabItem x:Name="DataPacksTab" Header="Data Packs" IsVisible="False">
                                <views:PackBrowserView x:Name="DataPacksView" Kind="DataPack" />
                            </TabItem>
                            <TabItem x:Name="ModsSettingsTab" Header="Mod Manager Settings">
                                <ScrollViewer Margin="0,12,0,0">
                                    <StackPanel Spacing="16">
                                        <Border Background="#1D1E22" CornerRadius="4" Padding="20" BorderBrush="#303137" BorderThickness="1">
                                            <StackPanel Spacing="12">
                                                <TextBlock Text="API CONFIGURATION" Foreground="{DynamicResource LadsAccent}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="Modrinth API URL" Foreground="#CCCCCC" FontSize="13" />
                                                    <TextBox x:Name="ModrinthApiUrlBox_ModTab" MinHeight="36" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="CurseForge API URL" Foreground="#CCCCCC" FontSize="13" />
                                                    <TextBox x:Name="CurseForgeApiUrlBox_ModTab" MinHeight="36" />
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="CurseForge API Key" Foreground="#CCCCCC" FontSize="13" />
                                                    <TextBox x:Name="CfApiKeyInputBox" PasswordChar="*" Height="36" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Changes save automatically and match Settings &#8594; Paths &amp; services." Foreground="#868994" FontSize="12" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                        <StackPanel Grid.Row="1" Spacing="4" Margin="0,8,0,0">
                            <TextBlock x:Name="ModsNoticeText" IsVisible="False" Foreground="#E27676" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="ModsStatusText" Text="" Foreground="#A0A1AA" FontSize="12" TextWrapping="Wrap" MaxHeight="72" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="LogsPage" IsVisible="False" Margin="28,24,28,24" RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
                            <TextBlock Text="Logs" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBox x:Name="LogSearchBox" Grid.Column="1" PlaceholderText="Search logs..." Height="36" FontSize="13" Margin="16,0" />
                            <Button Grid.Column="2" Classes="action" Content="Copy All" Height="36" FontSize="13" Padding="16,0" Margin="0,0,8,0" HorizontalContentAlignment="Center" Click="CopyLogs_Click" />
                            <Button Grid.Column="3" Classes="danger" Content="Clear" Height="36" FontSize="13" Padding="16,0" HorizontalContentAlignment="Center" Click="ClearLogs_Click" />
                        </Grid>
                        <TextBox x:Name="LogBox" VerticalContentAlignment="Top" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Background="#121315" Foreground="#88AA88" FontFamily="Consolas,Courier New" FontSize="12" BorderBrush="#303137" BorderThickness="1" CornerRadius="4" Padding="12" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                    <Grid x:Name="FilesPage" IsVisible="False" Margin="28,24,28,24" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                            <TextBlock Text="Files" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="FilesPathText" Classes="notranslate" Grid.Column="1" Text="" Foreground="#A0A1AA" FontSize="12" VerticalAlignment="Center" Margin="16,0,16,0" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="2" Classes="launch" Content="Open in Explorer" Height="36" FontSize="13" Padding="14,0" HorizontalContentAlignment="Center" Foreground="White" FontWeight="Bold" Click="FilesOpenExplorer_Click" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,8">
                            <Button Grid.Column="0" x:Name="FilesUpBtn" Classes="action" Content="Up" Height="34" FontSize="13" Padding="14,0" HorizontalContentAlignment="Center" Margin="0,0,8,0" Click="FilesUp_Click" />
                            <Button Grid.Column="1" Classes="action" Content="Refresh" Height="34" FontSize="13" Padding="14,0" HorizontalContentAlignment="Center" Click="FilesRefresh_Click" />
                        </Grid>
                        <ScrollViewer Grid.Row="2">
                            <StackPanel x:Name="FilesList" Spacing="3" />
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="GalleryPage" IsVisible="False" Margin="28,24,28,24" RowDefinitions="Auto,Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" Margin="0,0,0,12">
                            <TextBlock Text="Gallery" Foreground="White" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                            <ComboBox x:Name="GallerySortBox" Grid.Column="1" Width="120" Height="34" SelectedIndex="0" Margin="16,0,8,0" SelectionChanged="GallerySort_Changed">
                                <ComboBoxItem>Newest</ComboBoxItem>
                                <ComboBoxItem>Oldest</ComboBoxItem>
                                <ComboBoxItem>Name</ComboBoxItem>
                                <ComboBoxItem>Favorites</ComboBoxItem>
                            </ComboBox>
                            <TextBox x:Name="ImgurIdBox" Grid.Column="2" Width="160" Height="34" FontSize="12" PlaceholderText="Imgur Client ID" VerticalContentAlignment="Center" LostFocus="ImgurId_Changed" />
                            <TextBlock x:Name="GalleryStatusText" Grid.Column="3" Foreground="#A0A1AA" FontSize="12" VerticalAlignment="Center" Margin="8,0,12,0" TextTrimming="CharacterEllipsis" />
                            <Button Grid.Column="4" Classes="launch" Content="Open Folder" ToolTip.Tip="Open the shared screenshots folder (every version)" Height="34" FontSize="13" Padding="14,0" HorizontalContentAlignment="Center" Foreground="White" FontWeight="Bold" Click="GalleryOpenFolder_Click" />
                        </Grid>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <Button Classes="action" Content="Rescan" Click="GalleryRescan_Click" Padding="14,7" />
                            <Button Classes="action" Content="Add folder" Click="GalleryAddFolder_Click" Padding="14,7" />
                            <Button Classes="action" Content="Remove folder" ToolTip.Tip="Stop listing a folder you added. Its files are not touched." Click="GalleryRemoveFolder_Click" Padding="14,7" />
                            <TextBlock Text="Modrinth · CurseForge · Prism · Lads" Foreground="#90929D" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="2">
                            <StackPanel>
                                <WrapPanel x:Name="GalleryList" />
                                <Button x:Name="GalleryLoadMoreBtn" Classes="action" Content="Load more" IsVisible="False" Height="34" FontSize="13" Padding="14,0" Margin="6,8,6,6" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="GalleryLoadMore_Click" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                    <!-- Usage metrics: a status bar along the bottom of every page. -->
                    <Border Grid.Row="1" Background="#121315" BorderBrush="#303137" BorderThickness="0,1,0,0" Padding="28,8">
                        <Grid ColumnDefinitions="*,*,*,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="caption" Text="CPU" VerticalAlignment="Center" />
                                <TextBlock x:Name="CpuText" Text="&#8212;" FontSize="11" Foreground="#BEC0C8" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="caption" Text="MEMORY" VerticalAlignment="Center" />
                                <TextBlock x:Name="RamText" Text="&#8212;" FontSize="11" Foreground="#BEC0C8" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="caption" Text="MODS" VerticalAlignment="Center" />
                                <TextBlock x:Name="ModCountText" Text="&#8212;" FontSize="11" Foreground="#BEC0C8" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="caption" Text="GAME" VerticalAlignment="Center" />
                                <TextBlock x:Name="GameStateText" Text="&#8212;" FontSize="11" Foreground="#BEC0C8" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                                <TextBlock Classes="caption" Text="DOWNLOAD" VerticalAlignment="Center" />
                                <TextBlock x:Name="DownloadSpeedText" Text="&#8212;" FontSize="11" Foreground="#BEC0C8" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Grid x:Name="LauncherStartupOverlay" Background="#17181B" IsVisible="True" ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="18">
                    <Image x:Name="StartupLogoImage" Source="avares://TheLadsLauncher/Assets/logo.png" Width="520" Height="118" Stretch="Uniform" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="THE LADS CLIENT" HorizontalAlignment="Center" Foreground="White" FontSize="26" FontWeight="Bold" LetterSpacing="2.5" />
                    <Grid Width="560" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Bottom">
                            <TextBlock x:Name="StartupLoadingSpinner" Text="Loading resources" Foreground="#E9EAEE" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock x:Name="LoadingDots" Text="..." Foreground="#E9EAEE" FontSize="19" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock x:Name="StartupPercentText" Grid.Column="1" Text="" Foreground="{DynamicResource LadsAccent}" FontSize="30" FontWeight="Bold" VerticalAlignment="Bottom" />
                    </Grid>
                    <Border Width="560" Height="18" CornerRadius="9" Background="#22232C" BorderBrush="#30313D" BorderThickness="1" HorizontalAlignment="Center" ClipToBounds="True">
                        <Border x:Name="StartupProgressFill" Width="0" CornerRadius="9" HorizontalAlignment="Left" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#A8323B" Offset="0" />
                                    <GradientStop Color="#E0525B" Offset="0.6" />
                                    <GradientStop Color="#F07F86" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border x:Name="StartupProgressShine" Width="110" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                        <GradientStop Color="#55FFFFFF" Offset="0.5" />
                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.RenderTransform>
                                    <TranslateTransform X="-110" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </Border>
                    <local:MiningAnimation x:Name="StartupMining" Width="440" Height="200" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
            <Grid x:Name="GameLaunchOverlay" Background="#ED121315" IsVisible="False" ZIndex="90">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                    <TextBlock Text=" LAUNCHING THE LADS CLIENT" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="GameLaunchVersionText" Text="Minecraft" Foreground="#E27676" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="GameLaunchStatusText" Text="Initializing launch environment..." Foreground="#A0A1AA" FontSize="14" HorizontalAlignment="Center" />
                    <ProgressBar x:Name="GameLaunchProgressBar" Width="350" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{DynamicResource LadsAccent}" Background="#303137" CornerRadius="4" />
                    <Button x:Name="CancelLaunchButton" Classes="action" Content="Cancel" MinWidth="120" Height="34" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Click="CancelLaunch_Click" />
                </StackPanel>
            </Grid>
            <Grid x:Name="ManualLoginOverlay" Background="#F5121315" IsVisible="False" ZIndex="100">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                    <TextBlock Text="Manual Login Required" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="Your browser opened a Microsoft Login page. Please log in there." Foreground="#CCCCCC" FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Text="When you finish, you'll see a blank white page. COPY the URL of that page and PASTE it below:" Foreground="{DynamicResource LadsAccent}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="500" TextAlignment="Center" />
                    <TextBox x:Name="ManualUrlTextBox" Width="500" Height="30" PlaceholderText="https://login.live.com/oauth20_desktop.srf?code=..." Background="#303137" Foreground="White" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Content="Submit URL" Classes="action" Click="ManualLoginSubmit_Click" Width="150" HorizontalContentAlignment="Center" />
                        <Button Content="Cancel" Classes="danger" Click="ManualLoginCancel_Click" Width="100" HorizontalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            <Grid x:Name="GalleryViewerOverlay" IsVisible="False" Background="#EE000000" ZIndex="95" PointerWheelChanged="GalleryViewer_Wheel" ClipToBounds="True">
                <DockPanel LastChildFill="True" VerticalAlignment="Top" Height="48" Background="#18FFFFFF">
                    <Button DockPanel.Dock="Right" Content="&#10005;" Width="48" Height="48" FontSize="18" Click="GalleryViewerClose_Click" Background="Transparent" Foreground="#CCCCCC" />
                    <Button DockPanel.Dock="Right" x:Name="GalleryViewerFullscreenBtn" Content="&#9974;" Width="48" Height="48" FontSize="20" Click="GalleryViewerFullscreen_Click" Background="Transparent" Foreground="#CCCCCC" ToolTip.Tip="Toggle fullscreen" />
                    <TextBlock x:Name="GalleryViewerTitle" Classes="notranslate" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Image x:Name="GalleryViewerImage" Stretch="Uniform" Margin="0,48,0,36" RenderTransformOrigin="0.5,0.5" PointerPressed="GalleryViewer_PointerPressed" PointerMoved="GalleryViewer_PointerMoved" PointerReleased="GalleryViewer_PointerReleased" />
                <TextBlock x:Name="GalleryViewerMeta" Classes="notranslate" Foreground="#90929D" FontSize="11" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="Scroll to zoom &#183; drag to pan" Foreground="#55FFFFFF" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,12,10" />
            </Grid>
            <Border x:Name="UpdateBanner" Background="#211B1D" BorderBrush="#C44343" BorderThickness="1" MaxWidth="440" CornerRadius="4" Padding="14" Margin="0,48,24,0" HorizontalAlignment="Right" VerticalAlignment="Top" ZIndex="85" IsVisible="False">
                <StackPanel Spacing="4">
                    <TextBlock Text="Automatic updates" Foreground="White" FontSize="12" FontWeight="Bold" />
                    <TextBlock x:Name="UpdateBannerText" Foreground="#BBBBBB" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </LayoutTransformControl>
</Window>
